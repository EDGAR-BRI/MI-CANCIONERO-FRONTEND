---
import Layout from "./Layout.astro";
import { getUserFromToken } from "@/utils/auth";

interface Props {
    title: string;
}

const { title } = Astro.props;

// Check authorization
const token = Astro.cookies.get("token")?.value;
const user = getUserFromToken(token);

if (!token || !user) {
    return Astro.redirect("/login");
}

if (user.role !== "ADMIN") {
    return Astro.redirect("/");
}
---

<Layout title={`${title} | Panel de Administración`}>
    <main class="w-full max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8 min-w-0 flex-1">
        <slot />
    </main>
</Layout>
