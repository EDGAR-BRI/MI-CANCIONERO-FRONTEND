---
import "../styles/global.css";
const {
    title,
    description = "Cancionero virtual para músicos cristianos. Encuentra letras y acordes de tus canciones favoritas en CancioneroDigital.",
    image = "/favicon.svg", // Falta una imagen real de OG, usamos el favicon por ahora o un placeholder
} = Astro.props;

interface Props {
    title: string;
    description?: string;
    image?: string;
}

const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || "https://tusitio.com",
);
import { pwaInfo } from "virtual:pwa-info";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        {pwaInfo ? <Fragment set:html={pwaInfo.webManifest.linkTag} /> : <link rel="manifest" href="/manifest.webmanifest" />}
        <meta name="theme-color" content="#0a0a0a" />
        <script src="../pwa.ts"></script>

        <!-- Primary Meta Tags -->
        <title>Login</title>
        <meta name="title" content="Login" />
        <meta name="description" content="Login" />
        <link rel="canonical" href={canonicalURL} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, Astro.url)} />
    </head>
    <body
        class="bg-bg-main text-text-main h-screen w-full flex flex-col overflow-hidden"
    >
            <slot />

    </body>
</html>
