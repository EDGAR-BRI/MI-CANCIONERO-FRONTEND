---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { pwaInfo } from "virtual:pwa-info";

// Fonts
import "@fontsource/outfit";
import "@fontsource/jetbrains-mono";
const {
	title,
	description = "Mi canciónero el mejor cancionero digital para músicos católicos. Encuentra letras, acordes y herramientas de transposición para tu ministerio de música. Ademas crear tus misas con tus canciones favoritas.",
	image = "/favicon.svg", // Falta una imagen real de OG, usamos el favicon por ahora o un placeholder
	showMobileFooter = false,
} = Astro.props;

interface Props {
	title: string;
	description?: string;
	image?: string;
	showMobileFooter?: boolean;
}

const canonicalURL = new URL(
	Astro.url.pathname,
	Astro.site || "https://tusitio.com",
);

import Header from "../components/Header.astro";
import AdminHeader from "../components/AdminHeader.astro";
import Footer from "@/components/footer.astro";
import BottomNav from "@/components/BottomNav.astro";
import NavigationProgressBar from "@/components/NavigationProgressBar.astro";
import SplashScreen from "@/components/SplashScreen.astro";
import PwaInstallPrompt from "@/components/PwaInstallPrompt.astro";
import OfflineBannerReact from "@/components/OfflineBannerReact";

const isProfile = Astro.url.pathname === "/perfil" || Astro.url.pathname.startsWith("/perfil") || showMobileFooter;
const isAdmin = Astro.url.pathname === "/admin" || Astro.url.pathname.startsWith("/admin");
---

<!doctype html>
<html lang="es" class="h-full w-full overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		{pwaInfo ? <Fragment set:html={pwaInfo.webManifest.linkTag} /> : <link rel="manifest" href="/manifest.webmanifest" />}
		<meta name="theme-color" content="#0a0a0a" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Cancionero" />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />
		<script is:inline>
			// Capturar inmediatamente beforeinstallprompt antes de que cualquier script diferido se cargue
			window.addEventListener("beforeinstallprompt", (e) => {
				e.preventDefault();
				window.deferredPrompt = e;
				window.dispatchEvent(new CustomEvent("pwa-deferred-prompt-ready"));
			});
		</script>
		<ClientRouter />
		<slot name="head" />
	</head>
	<body class="bg-bg-main text-text-main min-h-screen w-full max-w-full overflow-x-hidden flex flex-col">
		<SplashScreen transition:persist="splash" />
		<NavigationProgressBar transition:persist="nav-progress" />
		{
			isAdmin ? (
				<AdminHeader transition:persist="admin-header" />
			) : (
				<Header transition:persist="header" class="" />
			)
		}
		<OfflineBannerReact client:load transition:persist="offline-banner" />
		<div
			class={`flex-1 flex flex-col w-full max-w-full min-w-0 ${!isProfile ? 'pb-[calc(4.5rem+env(safe-area-inset-bottom))] md:pb-0' : ''}`}
		>
			<div class="flex-1 w-full max-w-full min-w-0 flex flex-col">
				<slot />
			</div>
			<div class={`mt-auto ${isProfile || isAdmin ? 'hidden' : 'hidden md:block'}`}>
				<Footer />
			</div>
		</div>
		<BottomNav transition:persist="bottom-nav" />
		<PwaInstallPrompt transition:persist="pwa-install" />
		<script>
			import "@/pwa";
			import { initGlobalAlertSwipe } from "@/utils/alerts";
			import { syncOfflineQueue } from "@/services/offlineSync";

			initGlobalAlertSwipe();
			document.addEventListener("astro:page-load", () => {
				initGlobalAlertSwipe();
				if (navigator.onLine) {
					syncOfflineQueue().catch(() => {});
				}
			});

			window.addEventListener("online", () => {
				syncOfflineQueue().catch(() => {});
			});
		</script>
	</body>
</html>
