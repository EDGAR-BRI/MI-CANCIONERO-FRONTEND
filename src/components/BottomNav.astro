---
import { getUserFromToken, hasPermission } from "@/utils/auth";
import AppIcon from "@/components/Ui/AppIcon.astro";
import { getFluidNotchPath, getFluidNotchBgPath } from "@/utils/navShape";

const token = Astro.cookies.get("token")?.value;
const user = getUserFromToken(token);
const isLoggedIn = !!user;

const canCreateSong = hasPermission(user, "song.create");
const canViewAdmin = hasPermission(user, "view.admin");

const currentPath = Astro.url.pathname;

interface NavItem {
    href: string;
    path: string;
    label: string;
    icon: string;
}

const navItems: NavItem[] = [
    { href: "/", path: "/", label: "Inicio", icon: "house" },
    { href: "/misas", path: "/misas", label: "Misas", icon: "book" },
];

if (isLoggedIn && canCreateSong) {
    navItems.push({ href: "/songs/add", path: "/songs/add", label: "Agregar", icon: "plus" });
}

if (!canViewAdmin) {
    navItems.push({ href: "/songs/search/all", path: "/songs", label: "Canciones", icon: "music" });
} else {
    navItems.push({ href: "/admin/users", path: "/admin", label: "Admin", icon: "shield" });
}

navItems.push({ href: "/ministerios", path: "/ministerios", label: "Ministerios", icon: "users" });

// Encontrar índice activo según la ruta actual
const matchedIndex = navItems.findIndex((item) => {
    if (item.path === "/") return currentPath === "/";
    return currentPath.startsWith(item.path);
});
const activeIndex = matchedIndex;

// Cálculo inicial para SSR
const initialW = 390;
const initialCx = activeIndex >= 0 ? (activeIndex + 0.5) * (initialW / navItems.length) : null;
const initialTopD = getFluidNotchPath(initialW, initialCx);
const initialBgD = getFluidNotchBgPath(initialW, initialCx);
---

<nav
    id="bottom-nav"
    transition:persist="bottom-nav"
    data-active-index={activeIndex}
    data-total-items={navItems.length}
    class="md:hidden fixed bottom-0 left-0 w-full max-w-full z-50 pb-safe select-none transition-all duration-300"
    style="overflow-x: clip; overflow-y: visible;"
>
    <!-- Silueta SVG de fondo continuo y borde superior con muesca líquida transparente -->
    <svg
        id="bottom-nav-shape"
        class="absolute top-0 left-0 w-full pointer-events-none -z-10"
        style="height: calc(4rem + env(safe-area-inset-bottom, 0px)); overflow: hidden;"
        aria-hidden="true"
    >
        <path
            id="bottom-nav-bg"
            fill="#1A1A1A"
            d={initialBgD}
        />
        <path
            id="bottom-nav-border"
            fill="none"
            stroke="rgba(255, 255, 255, 0.1)"
            stroke-width="1"
            d={initialTopD}
        />
    </svg>

    <!-- Esfera flotante activa que se desliza con animación elástica -->
    <div
        id="bottom-nav-indicator"
        class={`absolute top-0 left-0 w-12 h-12 rounded-full bg-accent-main text-white flex items-center justify-center shadow-[0_8px_20px_rgba(255,87,34,0.45)] pointer-events-none z-20 transition-all duration-300 ${
            activeIndex >= 0 ? "opacity-100 scale-100" : "opacity-0 scale-50 pointer-events-none"
        }`}
        style={activeIndex >= 0 ? `transform: translate3d(calc(${initialCx}px - 50%), -14px, 0);` : `transform: translate3d(calc(${initialW / 2}px - 50%), -14px, 0);`}
        aria-hidden="true"
    >
        {
            navItems.map((item, idx) => (
                <div
                    data-indicator-icon-index={idx}
                    class={`absolute inset-0 flex items-center justify-center transition-all duration-200 ease-out ${
                        idx === activeIndex ? "opacity-100 scale-100" : "opacity-0 scale-50 pointer-events-none"
                    }`}
                >
                    <AppIcon name={item.icon} class="w-6 h-6 text-white" />
                </div>
            ))
        }
    </div>

    <!-- Items de navegación -->
    <div class="flex justify-around items-center h-16 relative z-10 w-full">
        {
            navItems.map((item, idx) => {
                const isCurrent = idx === activeIndex;
                return (
                    <a
                        href={item.href}
                        data-nav-index={idx}
                        data-nav-path={item.path}
                        class={`flex flex-col items-center justify-end flex-1 h-full pb-2 transition-all duration-300 relative group ${
                            isCurrent ? "text-accent-main font-semibold" : "text-text-secondary hover:text-text-main"
                        }`}
                        data-astro-prefetch
                    >
                        <div
                            class={`tab-icon-wrapper flex items-center justify-center mb-1 transition-all duration-300 ${
                                isCurrent ? "opacity-0 scale-75 -translate-y-2 pointer-events-none" : "opacity-100 scale-100 translate-y-0"
                            }`}
                        >
                            <AppIcon name={item.icon} class="text-xl w-5 h-5" />
                        </div>
                        <span class="text-[10px] tracking-tight truncate max-w-[64px] text-center leading-none">
                            {item.label}
                        </span>
                    </a>
                );
            })
        }
    </div>
</nav>

<style>
    .pb-safe {
        padding-bottom: env(safe-area-inset-bottom);
    }
</style>

<script>
    import { getFluidNotchPath, getFluidNotchBgPath, NOTCH_DEPTH } from "@/utils/navShape";

    let currentAnimFrame: number | null = null;
    let currentAnimatedCx: number | null = null;

    const getNavMetrics = () => {
        const nav = document.getElementById("bottom-nav");
        if (!nav) return null;
        const totalItems = parseInt(nav.getAttribute("data-total-items") || "5", 10);
        const w = nav.clientWidth || document.documentElement.clientWidth || window.innerWidth;
        return { nav, totalItems, w };
    };

    const getTabCx = (index: number, w: number, totalItems: number) => {
        const itemWidth = w / totalItems;
        return (index + 0.5) * itemWidth;
    };

    const animateNotchTo = (targetCx: number, durationMs = 380) => {
        const metrics = getNavMetrics();
        if (!metrics) return;
        const { w } = metrics;
        const bgPath = document.getElementById("bottom-nav-bg");
        const borderPath = document.getElementById("bottom-nav-border");
        const indicator = document.getElementById("bottom-nav-indicator");
        const progressPath = document.getElementById("navigation-progress-mobile-path");
        if (!bgPath || !borderPath) return;

        if (currentAnimFrame !== null) {
            cancelAnimationFrame(currentAnimFrame);
            currentAnimFrame = null;
        }

        const startCx = currentAnimatedCx !== null ? currentAnimatedCx : targetCx;
        const startTime = performance.now();

        // Función de resorte / elastic ease out suave
        const easeOutBack = (x: number): number => {
            const c1 = 1.3;
            const c3 = c1 + 1;
            return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2);
        };

        const step = (now: number) => {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / durationMs, 1);
            const eased = easeOutBack(progress);
            const curCx = startCx + (targetCx - startCx) * eased;
            currentAnimatedCx = curCx;

            bgPath.setAttribute("d", getFluidNotchBgPath(w, curCx));
            borderPath.setAttribute("d", getFluidNotchPath(w, curCx));
            if (indicator) {
                indicator.style.transform = `translate3d(calc(${curCx}px - 50%), -14px, 0)`;
            }
            if (progressPath) {
                progressPath.setAttribute("d", getFluidNotchPath(w, curCx));
            }

            if (progress < 1) {
                currentAnimFrame = requestAnimationFrame(step);
            } else {
                currentAnimatedCx = targetCx;
                currentAnimFrame = null;
                bgPath.setAttribute("d", getFluidNotchBgPath(w, targetCx));
                borderPath.setAttribute("d", getFluidNotchPath(w, targetCx));
                if (indicator) {
                    indicator.style.transform = `translate3d(calc(${targetCx}px - 50%), -14px, 0)`;
                }
                if (progressPath) progressPath.setAttribute("d", getFluidNotchPath(w, targetCx));
            }
        };

        currentAnimFrame = requestAnimationFrame(step);
    };

    const animateNotchDepth = (
        cx: number,
        fromDepth: number,
        toDepth: number,
        durationMs = 280,
        onComplete?: () => void
    ) => {
        const metrics = getNavMetrics();
        if (!metrics) return;
        const { w } = metrics;
        const bgPath = document.getElementById("bottom-nav-bg");
        const borderPath = document.getElementById("bottom-nav-border");
        const progressPath = document.getElementById("navigation-progress-mobile-path");
        if (!bgPath || !borderPath) return;

        if (currentAnimFrame !== null) {
            cancelAnimationFrame(currentAnimFrame);
            currentAnimFrame = null;
        }

        const startTime = performance.now();
        const easeOutQuad = (x: number) => 1 - (1 - x) * (1 - x);

        const step = (now: number) => {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / durationMs, 1);
            const eased = easeOutQuad(progress);
            const curD = fromDepth + (toDepth - fromDepth) * eased;

            bgPath.setAttribute("d", getFluidNotchBgPath(w, cx, curD));
            borderPath.setAttribute("d", getFluidNotchPath(w, cx, curD));
            if (progressPath) {
                progressPath.setAttribute("d", getFluidNotchPath(w, cx, curD));
            }

            if (progress < 1) {
                currentAnimFrame = requestAnimationFrame(step);
            } else {
                currentAnimFrame = null;
                if (toDepth <= 0) {
                    bgPath.setAttribute("d", getFluidNotchBgPath(w, null));
                    borderPath.setAttribute("d", getFluidNotchPath(w, null));
                    if (progressPath) progressPath.setAttribute("d", getFluidNotchPath(w, null));
                } else {
                    bgPath.setAttribute("d", getFluidNotchBgPath(w, cx, toDepth));
                    borderPath.setAttribute("d", getFluidNotchPath(w, cx, toDepth));
                    if (progressPath) progressPath.setAttribute("d", getFluidNotchPath(w, cx, toDepth));
                }
                if (onComplete) onComplete();
            }
        };

        currentAnimFrame = requestAnimationFrame(step);
    };

    const setActiveTabIndex = (activeIdx: number, immediate = false) => {
        const metrics = getNavMetrics();
        if (!metrics) return;
        const { nav, w, totalItems } = metrics;

        nav.setAttribute('data-active-index', activeIdx.toString());

        // Actualizar estados visuales de los enlaces
        const links = nav.querySelectorAll<HTMLAnchorElement>('a[data-nav-path]');
        links.forEach((link, idx) => {
            const isCurrent = idx === activeIdx;
            const iconWrapper = link.querySelector('.tab-icon-wrapper');
            if (isCurrent) {
                link.classList.remove('text-text-secondary', 'hover:text-text-main');
                link.classList.add('text-accent-main', 'font-semibold');
                if (iconWrapper) {
                    iconWrapper.classList.add('opacity-0', 'scale-75', '-translate-y-2', 'pointer-events-none');
                    iconWrapper.classList.remove('opacity-100', 'scale-100', 'translate-y-0');
                }
            } else {
                link.classList.remove('text-accent-main', 'font-semibold');
                link.classList.add('text-text-secondary', 'hover:text-text-main');
                if (iconWrapper) {
                    iconWrapper.classList.remove('opacity-0', 'scale-75', '-translate-y-2', 'pointer-events-none');
                    iconWrapper.classList.add('opacity-100', 'scale-100', 'translate-y-0');
                }
            }
        });

        // Alternar inmediatamente los iconos dentro de la esfera flotante indicadora
        const indicatorIcons = nav.querySelectorAll<HTMLElement>('[data-indicator-icon-index]');
        indicatorIcons.forEach((iconEl) => {
            const iconIdx = parseInt(iconEl.getAttribute('data-indicator-icon-index') || '-1', 10);
            if (iconIdx === activeIdx) {
                iconEl.classList.remove('opacity-0', 'scale-50', 'pointer-events-none');
                iconEl.classList.add('opacity-100', 'scale-100');
            } else {
                iconEl.classList.remove('opacity-100', 'scale-100');
                iconEl.classList.add('opacity-0', 'scale-50', 'pointer-events-none');
            }
        });

        const bgPath = document.getElementById("bottom-nav-bg");
        const borderPath = document.getElementById("bottom-nav-border");
        const indicator = document.getElementById("bottom-nav-indicator");
        const progressPath = document.getElementById("navigation-progress-mobile-path");

        if (activeIdx < 0) {
            // Sin pestaña activa (ej: vista /perfil)
            if (indicator) {
                indicator.classList.remove("opacity-100", "scale-100");
                indicator.classList.add("opacity-0", "scale-50", "pointer-events-none");
            }

            if (immediate || currentAnimatedCx === null) {
                if (currentAnimFrame !== null) {
                    cancelAnimationFrame(currentAnimFrame);
                    currentAnimFrame = null;
                }
                currentAnimatedCx = null;
                if (bgPath) bgPath.setAttribute("d", getFluidNotchBgPath(w, null));
                if (borderPath) borderPath.setAttribute("d", getFluidNotchPath(w, null));
                if (progressPath) progressPath.setAttribute("d", getFluidNotchPath(w, null));
            } else {
                // Suavizar colapso de la muesca
                animateNotchDepth(currentAnimatedCx, NOTCH_DEPTH, 0, 240, () => {
                    currentAnimatedCx = null;
                });
            }
            return;
        }

        // Con pestaña activa (activeIdx >= 0)
        const targetCx = getTabCx(activeIdx, w, totalItems);

        if (immediate) {
            if (currentAnimFrame !== null) {
                cancelAnimationFrame(currentAnimFrame);
                currentAnimFrame = null;
            }
            currentAnimatedCx = targetCx;
            if (bgPath) bgPath.setAttribute("d", getFluidNotchBgPath(w, targetCx));
            if (borderPath) borderPath.setAttribute("d", getFluidNotchPath(w, targetCx));
            if (progressPath) progressPath.setAttribute("d", getFluidNotchPath(w, targetCx));
            if (indicator) {
                indicator.style.transform = `translate3d(calc(${targetCx}px - 50%), -14px, 0)`;
                indicator.classList.remove("opacity-0", "scale-50", "pointer-events-none");
                indicator.classList.add("opacity-100", "scale-100");
            }
        } else {
            if (indicator) {
                indicator.classList.remove("opacity-0", "scale-50", "pointer-events-none");
                indicator.classList.add("opacity-100", "scale-100");
            }

            if (currentAnimatedCx === null) {
                // Viniendo de un estado sin muesca (ej: desde /perfil)
                currentAnimatedCx = targetCx;
                if (indicator) {
                    indicator.style.transform = `translate3d(calc(${targetCx}px - 50%), -14px, 0)`;
                }
                animateNotchDepth(targetCx, 0, NOTCH_DEPTH, 260);
            } else {
                // Desplazamiento horizontal fluido entre pestañas
                animateNotchTo(targetCx);
            }
        }
    };

    const updateActiveTabFromUrl = (immediate = false) => {
        const metrics = getNavMetrics();
        if (!metrics) return;
        const { nav } = metrics;

        const currentPath = window.location.pathname;
        const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[data-nav-path]'));
        const activeIdx = links.findIndex((link) => {
            const path = link.getAttribute('data-nav-path') || '';
            if (path === '/') return currentPath === '/';
            return currentPath.startsWith(path);
        });

        setActiveTabIndex(activeIdx, immediate);
    };

    const bindTabClicks = () => {
        const metrics = getNavMetrics();
        if (!metrics) return;
        const { nav } = metrics;
        const links = nav.querySelectorAll<HTMLAnchorElement>('a[data-nav-path]');
        links.forEach((link, idx) => {
            link.onclick = () => {
                const currentActive = parseInt(nav.getAttribute('data-active-index') || '-1', 10);
                if (idx !== currentActive) {
                    window.dispatchEvent(new CustomEvent('nav-progress:start'));
                    setActiveTabIndex(idx, false);
                }
            };
        });
    };

    // Inicializar posición según el estado actual en el DOM
    const initialActive = parseInt(document.getElementById("bottom-nav")?.getAttribute("data-active-index") || "-1", 10);
    if (initialActive >= 0) {
        const metrics = getNavMetrics();
        if (metrics) {
            currentAnimatedCx = getTabCx(initialActive, metrics.w, metrics.totalItems);
        }
    } else {
        currentAnimatedCx = null;
    }

    updateActiveTabFromUrl(true);
    bindTabClicks();

    document.addEventListener('astro:page-load', () => {
        updateActiveTabFromUrl(false);
        bindTabClicks();
    });

    window.addEventListener('resize', () => {
        updateActiveTabFromUrl(true);
        bindTabClicks();
    });
</script>
