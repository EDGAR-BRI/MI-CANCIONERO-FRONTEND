---
const { song } = Astro.props;
const categories = song.categories && song.categories.length > 0
    ? song.categories
    : (song.category ? [song.category] : []);
const authorName = song.author?.name || song.author || "Desconocido";
---

<a href={`/songs/${song.id}`} class="block group" data-astro-prefetch>
    <article
        class="bg-bg-secondary border border-white/5 rounded-xl p-5 hover:border-accent-main/50 transition-colors h-full flex flex-col justify-between"
    >
        <div>
            <h2
                transition:name={`song-title-${song.id}`}
                class="text-xl font-bold text-white group-hover:text-accent-main transition-colors mb-1 truncate"
            >
                {song.title}
            </h2>
            <p
                transition:name={`song-artist-${song.id}`}
                class="text-text-secondary text-sm mb-4 truncate"
            >
                {authorName}
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-1.5 pt-2">
            <span
                transition:name={`song-tone-${song.id}`}
                class="text-xs bg-white/5 px-2 py-1 rounded text-text-secondary group-hover:bg-accent-main/10 group-hover:text-accent-main transition-colors font-mono"
            >
                Ton: {song.key}
            </span>
            {categories.slice(0, 2).map((cat: any) => (
                <span
                    class="text-xs bg-white/5 px-2 py-1 rounded text-text-secondary group-hover:bg-accent-main/10 group-hover:text-accent-main transition-colors truncate max-w-[120px]"
                >
                    {cat.name}
                </span>
            ))}
            {categories.length > 2 && (
                <span class="text-[11px] bg-white/5 px-1.5 py-1 rounded text-text-secondary/70">
                    +{categories.length - 2}
                </span>
            )}
        </div>
    </article>
</a>
