---
import { getUserFromToken, hasPermission } from "@/utils/auth";
import SearchInput from "./SearchInput.astro";
import UserAvatar from "./UserAvatar.jsx";

const token = Astro.cookies.get("token")?.value;
const user = getUserFromToken(token);
const isLoggedIn = !!user;

const canCreateSong = hasPermission(user, "song.create");
const canViewAdmin = hasPermission(user, "view.admin");
---

<header
    class="w-full max-w-full flex items-center justify-between px-3 sm:px-4 md:px-8 py-2 sm:py-2.5 bg-bg-secondary/95 backdrop-blur-md border-b border-white/10 sticky top-0 z-50 min-w-0 shadow-sm"
>
    <div class="max-w-6xl w-full mx-auto flex items-center justify-between gap-2 sm:gap-3 min-w-0">
        <!-- Logo -->
        <div class="flex items-center gap-2 sm:gap-4 shrink-0">
            <a
                href="/"
                class="text-2xl font-bold text-accent-main tracking-tighter flex items-center shrink-0"
                data-astro-prefetch
            >
                <!-- Small Icon (Mobile: solo isologo) -->
                <img
                    src="/icono.svg"
                    alt="Cancionero"
                    class="h-8 w-auto block sm:hidden"
                />
                <!-- Medium Logo (Tablet) -->
                <img
                    src="/medium-logo.svg"
                    alt="Cancionero"
                    class="h-9 w-auto hidden sm:block lg:hidden"
                />
                <!-- Large Logo (Desktop) -->
                <img
                    src="/large-logo.svg"
                    alt="Cancionero"
                    class="h-10 w-auto hidden lg:block"
                />
            </a>
        </div>

        <!-- Search Input (Ocupa el centro de forma responsiva) -->
        <div class="flex-1 mx-1.5 sm:mx-6 min-w-0 max-w-sm sm:max-w-md md:max-w-lg">
            <SearchInput class="w-full min-w-0" />
        </div>

        <!-- Acciones Derecha (Perfil en móvil + Navegación en desktop) -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
            <!-- Mobile User Profile / Login (Visible solo en móvil) -->
            <div class="flex items-center md:hidden">
                {
                    isLoggedIn ? (
                        <a
                            href="/perfil"
                            class="shrink-0 active:scale-95 transition-transform flex items-center justify-center"
                            title={user?.name || "Mi Perfil"}
                            data-astro-prefetch
                        >
                            <UserAvatar
                                client:load
                                user={user}
                                size="w-11 h-11"
                                animate="always"
                            />
                        </a>
                    ) : (
                        <a
                            href="/login"
                            class="flex items-center justify-center w-9 h-9 rounded-full bg-white/5 border border-white/10 text-accent-main hover:bg-accent-main/10 hover:border-accent-main/30 active:scale-95 transition-all shrink-0 shadow-sm"
                            title="Ingresar"
                            data-astro-prefetch
                        >
                            <i class="fa-solid fa-user text-sm" />
                        </a>
                    )
                }
            </div>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex items-center gap-4">
                <ul
                    id="menu-list"
                    class="flex items-center gap-4 text-sm font-medium text-text-secondary md:h-9"
                >
                    <li
                        class="hover:text-text-main cursor-pointer transition-colors"
                    >
                        <a href="/misas" data-astro-prefetch>Misas</a>
                    </li>
                    <li
                        class="hover:text-text-main cursor-pointer transition-colors"
                    >
                        <a href="/ministerios" data-astro-prefetch>Ministerios</a>
                    </li>
                    {
                        isLoggedIn && canCreateSong && (
                            <li class="hover:text-text-main cursor-pointer transition-colors">
                                <a href="/songs/add" data-astro-prefetch>
                                    Add
                                </a>
                            </li>
                        )
                    }
                    {
                        isLoggedIn && canViewAdmin && (
                            <li class="hover:text-text-main cursor-pointer transition-colors">
                                <a href="/admin/users" data-astro-prefetch>
                                    Admin
                                </a>
                            </li>
                        )
                    }
                    {
                        isLoggedIn && (
                            <li class="hover:text-text-main cursor-pointer transition-colors">
                                <a href="/perfil" class="flex items-center gap-2 group" data-astro-prefetch>
                                    <UserAvatar
                                        client:load
                                        user={user}
                                        size="w-8 h-8"
                                        animate="always"
                                    />
                                    <span class="group-hover:text-accent-main transition-colors font-medium">{user?.name ? user.name.split(' ')[0] : 'Perfil'}</span>
                                </a>
                            </li>
                        )
                    }

                    {
                        !isLoggedIn && (
                            <li class="text-accent-main hover:text-accent-secondary cursor-pointer font-bold">
                                <a href="/login" data-astro-prefetch>
                                    Ingresar
                                </a>
                            </li>
                        )
                    }
                </ul>
            </nav>
        </div>
    </div>
</header>
