---
import type { Category } from "@/types/category";
const {
    title = "Título Desconocido",
    artist = "Artista Desconocido",
    tone = "C",
    category,
    categories: categoriesProp,
    url_song = "",
    user,
    id,
} = Astro.props;

const categories = categoriesProp && categoriesProp.length > 0
    ? categoriesProp
    : (category ? [category] : []);
---

<header class="mb-8">
    <h1
        class="text-4xl font-extrabold text-text-main mb-1"
        transition:name={`song title ${id}`}
    >
        {title}
    </h1>
    <h2 class="text-xl text-accent-main font-medium">
        <span class="text-text-secondary">Autor:</span>
        <span transition:name={`song artist ${id}`}>{artist}</span>
    </h2>
    <div
        class="flex flex-col sm:flex-row sm:justify-start justify-between gap-4 mt-4 text-sm text-text-secondary"
    >
        <div class="flex flex-wrap items-center justify-start gap-2">
            <span
                transition:name={`song tone ${id}`}
                class="bg-bg-secondary px-3 py-1 rounded-full border border-white/10"
            >
                Ton: <span id="header-tone" class="text-accent-main font-bold"
                    >{tone}</span
                >
            </span>
            {categories.map((cat: any) => (
                <a href={`/songs/search/all?categoryId=${cat.id}`} target="_blank">
                    <span
                        class="cursor-pointer hover:underline bg-bg-secondary hover:bg-white/10 px-3 py-1 rounded-full border border-white/10 text-accent-main/90 font-bold transition-colors"
                    >
                        {cat.name}
                    </span>
                </a>
            ))}
        </div>
        {
            user && (
                <span class="text-sm text-text-secondary/80 sm:ml-auto ml-0">
                    Creado por: {user.name}
                </span>
            )
        }
    </div>
</header>

<script>
    import { transposeChord } from "../utils/music";

    const headerTone = document.getElementById("header-tone");

    window.addEventListener("song-transpose", (e: any) => {
        if (!headerTone) return;
        const semitones = e.detail.semitones;
        const currentTone = headerTone.innerText.trim();
        const newTone = transposeChord(currentTone, semitones);
        headerTone.innerText = newTone;
    });
</script>
