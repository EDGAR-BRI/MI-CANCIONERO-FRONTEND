---
import packageJson from "../../package.json";
const version = packageJson.version;
---

<div
	id="pwa-splash-screen"
	transition:persist
	class="fixed inset-0 z-[999999] bg-bg-main flex flex-col items-center justify-between py-12 px-6 transition-opacity duration-300 ease-out pointer-events-none select-none"
	style="display: none; opacity: 1;"
	aria-hidden="true"
>
	<!-- Centro: Logo y Título -->
	<div class="flex-1 flex flex-col items-center justify-center text-center">
		<div class="relative mb-5">
			<img
				src="/pwa-192x192.png"
				alt="Cancionero Digital"
				class="w-24 h-24 rounded-2xl shadow-2xl border border-white/10"
				draggable="false"
			/>
		</div>
		<h1 class="text-2xl font-bold text-white tracking-tight font-sans">Cancionero Digital</h1>
		<p class="text-xs text-text-secondary mt-1 tracking-wide">Letras y Acordes Litúrgicos</p>
	</div>

	<!-- Pie: Versión y Estado -->
	<div class="flex flex-col items-center gap-2 pb-6">
		<span class="bg-white/5 border border-white/10 text-text-secondary px-3 py-1 rounded-full text-xs font-mono">
			v{version}
		</span>
	</div>
</div>

<script is:inline>
	(function () {
		const isStandalone =
			window.matchMedia("(display-mode: standalone)").matches ||
			window.navigator.standalone === true;
		const isPreview = new URLSearchParams(window.location.search).has("splash");
		const hasShown = sessionStorage.getItem("pwa_splash_shown");

		// Mostrar únicamente al iniciar la PWA instalada o en modo preview (?splash)
		if ((isStandalone && !hasShown) || isPreview) {
			const splash = document.getElementById("pwa-splash-screen");
			if (splash) {
				splash.style.display = "flex";
				splash.classList.remove("pointer-events-none");

				const hideSplash = () => {
					splash.style.opacity = "0";
					splash.classList.add("pointer-events-none");
					sessionStorage.setItem("pwa_splash_shown", "true");
					setTimeout(() => {
						splash.style.display = "none";
					}, 350);
				};

				// Ocultar suavemente después de 900ms
				setTimeout(hideSplash, 900);
			}
		}
	})();
</script>
