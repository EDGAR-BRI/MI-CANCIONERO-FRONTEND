---
import AppIcon from "./AppIcon.astro";

interface Props {
    id?: string;
    type?: "button" | "submit" | "reset";
    icon?: "sparkles" | "wand" | "search" | "none";
    text?: string;
    mobileText?: string;
    title?: string;
    class?: string;
    disabled?: boolean;
    [key: string]: any;
}

const {
    id,
    type = "button",
    icon = "sparkles",
    text,
    mobileText,
    title,
    class: className = "",
    disabled = false,
    ...rest
} = Astro.props;
---

<button
    type={type}
    id={id}
    title={title}
    disabled={disabled}
    class:list={[
        "relative group overflow-hidden flex items-center justify-center gap-2 py-2 px-3.5 text-xs sm:text-sm font-bold text-white rounded-xl bg-linear-to-r from-purple-600 via-indigo-600 to-purple-600 bg-[length:200%_auto] hover:bg-right transition-all duration-300 shadow-md shadow-purple-950/40 border border-purple-400/25 active:scale-95 cursor-pointer disabled:opacity-50 disabled:pointer-events-none",
        className,
    ]}
    {...rest}
>
    {/* Iconos vectoriales integrados */}
    {icon === "wand" && (
        <AppIcon
            name="wand-magic-sparkles"
            class="w-4 h-4 shrink-0 transition-transform group-hover:rotate-12"
        />
    )}

    {icon === "sparkles" && (
        <AppIcon
            name="wand-magic-sparkles"
            class="w-4 h-4 shrink-0 transition-transform group-hover:scale-110"
        />
    )}

    {icon === "search" && (
        <AppIcon
            name="magnifying-glass"
            class="w-4 h-4 shrink-0 transition-transform group-hover:scale-110"
        />
    )}

    {/* Texto responsivo */}
    {text && (
        mobileText ? (
            <>
                <span class="inline sm:hidden truncate">{mobileText}</span>
                <span class="hidden sm:inline truncate">{text}</span>
            </>
        ) : (
            <span class="truncate">{text}</span>
        )
    )}

    <slot />
</button>
