---
// export const prerender = false;
Astro.response.headers.set(
	"Cache-Control",
	"no-cache, no-store, must-revalidate",
);
import Layout from "@/layouts/Layout.astro";
import "../styles/global.css";

import { getUserFromToken } from "@/utils/auth";
import { API_URL } from "@/services/songs";
import { getMisas } from "@/services/misas";
import { getMyMinistries, type MinistrySummary } from "@/services/ministries";
import type { Misa } from "@/types/misa";

import HomeDashboardReact from "@/components/HomeDashboardReact";
import GridSongs from "@/components/GridSongs.jsx";
import CategoryFilter from "@/components/CategoryFilter.jsx";

const token = Astro.cookies.get("token")?.value;
const user = getUserFromToken(token);

let initialMisas: Misa[] = [];
let initialMinistries: MinistrySummary[] = [];

try {
	const misasRes = await getMisas(token);
	if (misasRes.success && Array.isArray(misasRes.data)) {
		initialMisas = misasRes.data;
	}
} catch (e) {
	console.error("Error fetching misas on SSR:", e);
}

if (user && token) {
	try {
		const minRes = await getMyMinistries(token);
		if (minRes.success && minRes.data?.ministries) {
			initialMinistries = minRes.data.ministries;
		}
	} catch (e) {
		console.error("Error fetching ministries on SSR:", e);
	}
}

const seoTitle = "Cancionero Digital | Letras y Acordes Católicos";
const seoDescription =
	"Cancionero digital litúrgico para músicos y coros católicos. Administra tus ministerios, planifica tus misas y transporta tonos con facilidad.";

const schema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Cancionero Digital",
	url: Astro.url.origin,
	description: seoDescription,
	potentialAction: {
		"@type": "SearchAction",
		target: `${Astro.url.origin}/songs/search/{search_term_string}`,
		"query-input": "required name=search_term_string",
	},
};
---

<Layout title={seoTitle} description={seoDescription}>
	<script
		type="application/ld+json"
		slot="head"
		set:html={JSON.stringify(schema)}
	/>
	<div class="flex flex-col min-h-screen bg-bg-main text-text-main pb-24 md:pb-12">
		<main class="flex-1 max-w-5xl mx-auto w-full px-3 sm:px-6 md:px-8 py-4 sm:py-7 space-y-7 sm:space-y-9">
			<!-- Dashboard Principal: Opciones Rápidas, Próxima Misa y Momentos Litúrgicos -->
			<HomeDashboardReact
				client:load
				currentUser={user}
				token={token}
				initialMisas={initialMisas}
				initialMinistries={initialMinistries}
			/>

			<!-- Catálogo de Canciones: Filtros y Últimas Agregadas -->
			<section class="space-y-4 pt-2">
				<div class="flex items-center justify-between">
					<div>
						<h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2">
							<i class="fa-solid fa-music text-accent-main text-base sm:text-lg"></i>
							<span>Canciones Recientes</span>
						</h2>
						<p class="text-xs text-zinc-400 mt-0.5">
							Explora los últimos cantos agregados con acordes
						</p>
					</div>
					<a
						href="/songs/search/all"
						class="text-xs font-semibold text-accent-main hover:text-amber-400 transition-colors flex items-center gap-1 shrink-0"
						data-astro-prefetch
					>
						<span>Ver todas</span>
						<i class="fa-solid fa-angle-right text-[10px]"></i>
					</a>
				</div>

				<CategoryFilter client:load isAdmin={user?.role === "ADMIN"} />

				<GridSongs client:load endpoint={`${API_URL}/songs?limit=12`} />
			</section>
		</main>
	</div>
</Layout>
