---
const { search } = Astro.params;
const decodedSearch = search ? decodeURIComponent(search) : "";
const token = Astro.cookies.get("token")?.value;
import Layout from "@/layouts/Layout.astro";
import { getUserFromToken, hasPermission } from "@/utils/auth";
import { API_URL } from "@/services/songs";
import SearchResultsViewReact from "@/components/SearchResultsViewReact";
import type { Category } from "@/types/category";

const user = getUserFromToken(token);
const canCreate = hasPermission(user, "song.create");
const isMusician = Boolean(canCreate || user?.role === "MUSICO" || user?.role === "ADMIN");

let categories: Category[] = [];
try {
    const res = await fetch(`${API_URL}/categories`);
    if (res.ok) {
        categories = await res.json();
    }
} catch (e) {
    console.error("Error fetching categories in search page:", e);
}

const currentCategoryId = Astro.url.searchParams.get("categoryId");
const initialTab = (isMusician && Astro.url.searchParams.get("tab") === "external") ? "external" : "local";
---

<Layout title={`CancioneroDigital - ${decodedSearch === "all" ? "Explorar Canciones" : `Buscando: ${decodedSearch}`}`}>
    <div class="flex flex-col min-h-screen bg-bg-main text-text-main pb-24 md:pb-12">
        <main class="flex-1 max-w-6xl mx-auto w-full px-3 py-4 sm:p-6 md:p-8">
            <SearchResultsViewReact
                client:load
                initialQuery={decodedSearch}
                initialCategoryId={currentCategoryId}
                initialTab={initialTab}
                categories={categories}
                token={token}
                user={user}
                canCreate={canCreate}
                isMusician={isMusician}
                apiUrl={API_URL}
            />
        </main>
    </div>
</Layout>
