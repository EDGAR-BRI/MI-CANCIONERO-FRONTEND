---
// export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ChordEditor from "@/components/ChordEditor.jsx";
import "@/styles/global.css";
import type { Category } from "@/types/category";
import type { Author } from "@/types/author";
import { createSong, API_URL } from "@/services/songs";
import AiButton from "@/components/Ui/AiButton.astro";
import AiAutocompleteButton from "@/components/Ui/AiAutocompleteButton.astro";
import CategoryMultiSelectReact from "@/components/CategoryMultiSelectReact";
import AuthorSelectReact from "@/components/AuthorSelectReact";
import SearchExternalSongModal from "@/components/SearchExternalSongModal";

import { getUserFromToken, hasPermission } from "@/utils/auth";


const token = Astro.cookies.get("token")?.value;
const user = getUserFromToken(token);

if (!token || !user) {
    return Astro.redirect("/login");
}

if (!hasPermission(user, "song.create")) {
    return Astro.redirect("/");
}

let categories: Category[] = [];
try {
    const res = await fetch(`${API_URL}/categories`);
    if (res.ok) {
        categories = await res.json();
    }
} catch (e) {
    console.error("Error fetching categories:", e);
}

let authors: Author[] = [];
try {
    const resAuthors = await fetch(`${API_URL}/authors`);
    if (resAuthors.ok) {
        authors = await resAuthors.json();
    }
} catch (e) {
    console.error("Error fetching authors:", e);
}

let errorMessage = "";

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const result = await createSong(formData, token);

    if (result.success) {
        return Astro.redirect(`/songs/${result.data.id}`);
    } else {
        errorMessage = result.error || "Error desconocido";
    }
}
---

<Layout title="Subir Canción">
    <div class="flex flex-col h-full bg-bg-main text-text-main">
        <main class="flex-1 max-w-6xl mx-auto w-full px-3 py-4 sm:p-6 md:p-10">
            <h1 class="text-3xl font-bold text-accent-main mb-8">
                Enviar Cifrado
            </h1>

            {}

            <form class="space-y-8" method="POST">
                {/* Info Básica (Grid de 3 columnas para aprovechar espacio) */}
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="space-y-2">
                        <label
                            class="block text-sm font-medium text-text-secondary"
                            >Autor / Compositor</label
                        >
                        <AuthorSelectReact
                            client:load
                            authors={authors}
                            token={token}
                        />
                    </div>

                    <div class="space-y-2">
                        <label
                            for="title"
                            class="block text-sm font-medium text-text-secondary"
                            >Nombre de la canción</label
                        >
                        <input
                            type="text"
                            id="title"
                            name="title"
                            class="w-full bg-bg-secondary border border-white/10 rounded-lg p-3 text-text-main focus:outline-none focus:border-accent-main transition-colors placeholder-white/20"
                            placeholder="Ej. Dios está aquí"
                            required
                        />
                    </div>

                    <div class="space-y-2">
                        <label
                            for="key"
                            class="block text-sm font-medium text-text-secondary"
                            >Tono Principal</label
                        >
                        <select
                            id="key"
                            name="key"
                            class="w-full bg-bg-secondary border border-white/10 rounded-lg p-3 text-text-main focus:outline-none focus:border-accent-main transition-colors appearance-none cursor-pointer"
                        >
                            {
                                [
                                    "C",
                                    "Cm",
                                    "C#",
                                    "C#m",
                                    "D",
                                    "Dm",
                                    "D#",
                                    "D#m",
                                    "E",
                                    "Em",
                                    "F",
                                    "Fm",
                                    "F#",
                                    "F#m",
                                    "G",
                                    "Gm",
                                    "G#",
                                    "G#m",
                                    "A",
                                    "Am",
                                    "A#",
                                    "A#m",
                                    "B",
                                    "Bm",
                                ].map((k) => <option value={k}>{k}</option>)
                            }
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label
                            for="url_song"
                            class="block text-sm font-medium text-text-secondary"
                            >Link del Video (YouTube)</label
                        >
                        <input
                            type="url"
                            id="url_song"
                            name="url_song"
                            class="w-full bg-bg-secondary border border-white/10 rounded-lg p-3 text-text-main focus:outline-none focus:border-accent-main transition-colors placeholder-white/20"
                            placeholder="https://youtube.com/..."
                        />
                    </div>

                    <CategoryMultiSelectReact
                        client:load
                        categories={categories}
                        token={token}
                    />
                </div>

                <div class="border-t border-white/10 pt-6">
                    <div
                        class="mb-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-4"
                    >
                        <div>
                            <h3 class="text-xl font-semibold text-white">
                                Letra y Acordes
                            </h3>
                            <p class="text-sm text-text-secondary">
                                Escribe la letra y usa los botones para insertar
                                los acordes en la posición exacta.
                            </p>
                        </div>
                        <div class="grid grid-cols-2 sm:flex items-center gap-2 w-full sm:w-auto">
                            <AiButton
                                id="btn-ai-search-song"
                                icon="search"
                                text="Autocompletar canción"
                                mobileText="Autocompletar"
                                title="Buscar canciones y acordes en internet para autocompletar"
                            />
                            <AiAutocompleteButton
                                token={token}
                                apiUrl={API_URL}
                                showIconOnly={false}
                            />
                        </div>
                    </div>

                    {/* AQUÍ VA LA MAGIA DE REACT */}
                    {
                        /* Pasamos 'name="content"' para que el form lo reconozca */
                    }
                    <ChordEditor client:only="react" name="content" />
                </div>

                <div class="flex justify-end pt-4">
                    <button
                        type="submit"
                        class="bg-accent-main hover:bg-accent-main/90 text-white font-bold py-3 px-8 rounded-lg transition-transform transform hover:scale-105 shadow-lg shadow-accent-main/20"
                    >
                        Guardar Canción
                    </button>
                </div>
            </form>
        </main>
    </div>
    {/* Modal para crear categoría */}
    <dialog
        id="modal-category"
        class="bg-bg-secondary text-text-main border border-white/10 rounded-2xl p-5 sm:p-6 backdrop:bg-black/80 backdrop:backdrop-blur-sm shadow-2xl w-full max-w-sm m-auto max-h-[calc(100dvh-2rem)] overscroll-contain select-auto"
    >
        <form method="dialog" class="space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-white/5">
                <h3 class="text-base sm:text-lg font-bold text-white tracking-tight">Nueva Categoría</h3>
                <button
                    value="cancel"
                    type="submit"
                    class="p-1.5 text-text-secondary hover:text-white hover:bg-white/10 rounded-xl transition-colors cursor-pointer shrink-0 -mr-1"
                    title="Cerrar"
                    aria-label="Cerrar"
                >
                    <AppIcon name="xmark" class="w-5 h-5" />
                </button>
            </div>
            <div class="space-y-1.5">
                <label for="new-cat-name" class="block text-xs font-semibold text-text-secondary uppercase tracking-wider">
                    Nombre <span class="text-accent-main">*</span>
                </label>
                <input
                    type="text"
                    id="new-cat-name"
                    class="w-full bg-bg-main border border-white/10 focus:border-accent-main rounded-xl px-4 py-2.5 text-white text-sm outline-none transition-colors"
                    placeholder="Ej. Adoración"
                />
            </div>
            <div class="flex justify-end gap-2 pt-2">
                <button
                    value="cancel"
                    class="px-4 py-2 text-sm text-text-secondary hover:text-white rounded-xl transition-colors cursor-pointer"
                    >Cancelar</button
                >
                <button
                    id="btn-save-category"
                    type="button"
                    class="px-4 py-2 text-sm bg-accent-main hover:bg-accent-main/90 text-white font-bold rounded-xl transition-colors shadow-md cursor-pointer"
                    >Guardar</button
                >
            </div>
        </form>
    </dialog>

    {/* Modal para buscar canciones en internet con Vista Previa */}
    <SearchExternalSongModal
        client:load
        apiUrl={API_URL}
        token={token}
        user={user}
        categories={categories}
        canCreate={true}
    />

    <div
        id="add-song-data"
        data-api-url={API_URL}
        data-error-message={errorMessage}
        data-token={token}
        class="hidden"
    >
    </div>

    <script>
        import {
            showError,
            showSuccessToast,
            showConfirm,
            showLoading,
        } from "@/utils/alerts";

        const initAddSongPage = () => {
            console.log("Initializing Add Song Page script");
            const dataElement = document.getElementById("add-song-data");

            // If we are not on the add song page, add-song-data might not exist
            if (!dataElement) return;

            const API_URL = dataElement?.dataset.apiUrl;
            const errorMessage = dataElement?.dataset.errorMessage;
            const token = dataElement?.dataset.token;

            if (errorMessage) {
                console.error("Error Message:", errorMessage);
            }

            // Check for prefilled external song from search view or suggestions
            const prefillRaw = sessionStorage.getItem("prefill_external_song");
            if (prefillRaw) {
                try {
                    const data = JSON.parse(prefillRaw);
                    const chordContent = data.chordPro || data.content;

                    const applyPrefill = () => {
                        const titleInput = document.querySelector("#title") as HTMLInputElement | null;
                        if (titleInput && data.title && !titleInput.value) {
                            titleInput.value = data.title;
                        }

                        if (data.artist) {
                            window.dispatchEvent(new CustomEvent("set-author", {
                                detail: { name: data.artist }
                            }));
                        }

                        if (data.key) {
                            const keySelect = document.querySelector("#key") as HTMLSelectElement | null;
                            if (keySelect) {
                                keySelect.value = data.key;
                                window.dispatchEvent(new CustomEvent("song-key-change", {
                                    detail: { key: data.key }
                                }));
                            }
                        }

                        if (data.youtubeUrl) {
                            const urlInput = document.querySelector("#url_song") as HTMLInputElement | null;
                            if (urlInput && !urlInput.value) {
                                urlInput.value = data.youtubeUrl;
                            }
                        }

                        if (data.categories && data.categories.length > 0) {
                            window.dispatchEvent(new CustomEvent("set-categories", {
                                detail: { names: data.categories }
                            }));
                        }

                        if (chordContent) {
                            window.dispatchEvent(new CustomEvent("update-editor-content", {
                                detail: { content: chordContent, key: data.key }
                            }));
                        }
                    };

                    // Intento inmediato y reintentos para asegurar que todas las islas de React lo capturen
                    applyPrefill();
                    setTimeout(applyPrefill, 100);
                    setTimeout(applyPrefill, 350);
                    setTimeout(applyPrefill, 700);
                    setTimeout(() => {
                        applyPrefill();
                        sessionStorage.removeItem("prefill_external_song");
                        showSuccessToast("¡Datos cargados!", `${data.title} listo para editar`);
                    }, 1200);

                    // Escuchar si ChordEditor avisa que acaba de montarse
                    window.addEventListener("chord-editor-mounted", applyPrefill, { once: true });
                } catch (e) {
                    console.error("Error reading prefilled external song:", e);
                    sessionStorage.removeItem("prefill_external_song");
                }
            }

            // --- Category Logic ---
            console.log("Initializing category logic...");

            const btnNewCategory = document.querySelector(
                "#btn-new-category",
            ) as HTMLButtonElement | null;
            const modalCategory = document.querySelector(
                "#modal-category",
            ) as HTMLDialogElement | null;
            const btnSaveCategory = document.querySelector(
                "#btn-save-category",
            ) as HTMLButtonElement | null;
            const inputCatName = document.querySelector(
                "#new-cat-name",
            ) as HTMLInputElement | null;
            const selectCategory = document.querySelector(
                "#categoryId",
            ) as HTMLSelectElement | null;
            const closeCategoryBtn = document.querySelector(
                "#modal-category button[value='cancel']",
            ) as HTMLButtonElement | null;

            // Helper to remove listeners (cloning)
            const replaceWithClone = (element: Element): Element => {
                const newElement = element.cloneNode(true) as Element;
                element.parentNode?.replaceChild(newElement, element);
                return newElement;
            };

            if (btnNewCategory && modalCategory) {
                const newBtnNewCategory = replaceWithClone(btnNewCategory);

                newBtnNewCategory.addEventListener("click", (e) => {
                    e.preventDefault();
                    modalCategory.showModal();
                    if (inputCatName) {
                        inputCatName.value = "";
                        inputCatName.focus();
                    }
                });
            }

            if (closeCategoryBtn && modalCategory) {
                const newCloseCategoryBtn = replaceWithClone(closeCategoryBtn);
                newCloseCategoryBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    modalCategory.close();
                });
            }

            if (btnSaveCategory) {
                const newBtnSaveCategory = replaceWithClone(
                    btnSaveCategory,
                ) as HTMLButtonElement;
                newBtnSaveCategory.addEventListener("click", async () => {
                    const name = inputCatName?.value.trim();
                    if (!name) return;

                    try {
                        newBtnSaveCategory.disabled = true;
                        newBtnSaveCategory.textContent = "Guardando...";

                        if (!API_URL) throw new Error("API URL not found");

                        const headers: Record<string, string> = {
                            "Content-Type": "application/json",
                        };

                        if (token) {
                            headers["Authorization"] = `Bearer ${token}`;
                        }

                        const res = await fetch(`${API_URL}/categories`, {
                            method: "POST",
                            headers: headers,
                            body: JSON.stringify({ name }),
                        });

                        if (res.ok) {
                            const newCat = await res.json();
                            // Agregar al select
                            const option = document.createElement("option");
                            option.value = newCat.id;
                            option.textContent = newCat.name;
                            option.selected = true; // Seleccionar automáticamente
                            selectCategory?.appendChild(option);

                            modalCategory?.close();

                            console.log("¡Categoría creada!");
                        } else {
                            const err = await res.json();
                            console.error("Error al crear la categoría", err);
                        }
                    } catch (e) {
                        console.error(e);
                        console.error("Error de conexión");
                    } finally {
                        newBtnSaveCategory.disabled = false;
                        newBtnSaveCategory.textContent = "Guardar";
                    }
                });
            }

            // --- Main Form Logic ---
            const mainForm = document.querySelector(
                "main form",
            ) as HTMLFormElement | null;

            if (mainForm) {
                // Not cloning form to keep reacting with ChordEditor probably?
                // Actually ChordEditor is outside the form or handled by React...
                // Wait, ChordEditor contains hidden input named "content".
                // Cloning the form might break React mounting if it was inside, but ChordEditor is distinct.
                // However, attaching a submit listener multiple times is bad.
                // Let's use a flag.
                if (!mainForm.dataset.listenerAttached) {
                    mainForm.addEventListener("submit", () => {
                        const mainSubmitBtn = mainForm.querySelector(
                            "button[type='submit']",
                        );
                        if (mainSubmitBtn) {
                            mainSubmitBtn.setAttribute("disabled", "true");
                            mainSubmitBtn.innerHTML = "Guardando...";
                            mainSubmitBtn.classList.add(
                                "opacity-75",
                                "cursor-not-allowed",
                            );
                        }
                    });
                    mainForm.dataset.listenerAttached = "true";
                }
            }

            // --- External Search & Autocomplete Song Modal ---
            const btnAISearch = document.getElementById(
                "btn-ai-search-song",
            ) as HTMLButtonElement | null;

            if (btnAISearch) {
                const newBtnAISearch = replaceWithClone(
                    btnAISearch,
                ) as HTMLButtonElement;

                newBtnAISearch.addEventListener("click", () => {
                    const titleInput = document.querySelector(
                        "#title",
                    ) as HTMLInputElement | null;
                    const initialQuery = titleInput?.value?.trim() || "";
                    window.dispatchEvent(
                        new CustomEvent("open-external-search-modal", {
                            detail: { query: initialQuery },
                        }),
                    );
                });
            }


            // --- Key Logic ---
            const keySelect = document.querySelector(
                "#key",
            ) as HTMLSelectElement | null;

            if (keySelect) {
                // Should we clone keySelect? Replacing it might break if something else holds a reference (unlikely)
                // But let's clone to clear listeners
                const newKeySelect = replaceWithClone(
                    keySelect,
                ) as HTMLSelectElement;
                newKeySelect.addEventListener("change", (e) => {
                    const target = e.target as HTMLSelectElement;
                    const newKey = target.value;
                    const event = new CustomEvent("song-key-change", {
                        detail: { key: newKey },
                    });
                    window.dispatchEvent(event);
                });

                // Escuchar cambios desde el editor de acordes
                window.addEventListener("editor-key-change", (e) => {
                    if (e instanceof CustomEvent) {
                        // Need to re-query active keySelect because replaceWithClone might have created a new one
                        const currentKeySelect = document.querySelector(
                            "#key",
                        ) as HTMLSelectElement | null;
                        if (currentKeySelect && e.detail && e.detail.key) {
                            currentKeySelect.value = e.detail.key;
                        }
                    }
                });
            }
        };

        // Attach to both events
        document.addEventListener("DOMContentLoaded", initAddSongPage);
        document.addEventListener("astro:page-load", initAddSongPage);
    </script>
</Layout>
