---
import AppIcon from "@/components/Ui/AppIcon.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { API_URL } from "@/services/songs";

const token = Astro.cookies.get("token")?.value;

let users = [];
let roles = [];
let error = null;

try {
    const headers = {
        Authorization: `Bearer ${token}`,
        Cookie: `token=${token}`,
    };

    const res = await fetch(`${API_URL}/users`, { headers });
    if (res.ok) {
        users = await res.json();
    } else {
        if (res.status === 403 || res.status === 401) {
            return Astro.redirect("/");
        }
        error = "Error al cargar la lista de usuarios.";
    }

    const rolesRes = await fetch(`${API_URL}/roles`, { headers });
    if (rolesRes.ok) {
        roles = await rolesRes.json();
    }
} catch (e) {
    error = "Error de conexión al cargar usuarios.";
}
---

<AdminLayout title="Gestión de Usuarios">
    <div id="users-page" class="space-y-6" data-api-url={API_URL} data-token={token}>
        <!-- Page Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
                    Gestión de Usuarios
                </h1>
                <p class="text-xs sm:text-sm text-text-secondary mt-1">
                    Administra cuentas, asignación de roles y números de contacto de la comunidad.
                </p>
            </div>

            <button
                id="openCreateModal"
                type="button"
                class="bg-accent-main hover:bg-accent-main/90 text-white font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-xl transition-colors shadow-md flex items-center justify-center gap-2 w-full sm:w-auto"
            >
                <AppIcon name="user-plus" />
                <span>Nuevo Usuario</span>
            </button>
        </div>

        {
            error && (
                <div class="bg-red-500/10 border border-red-500/30 text-red-300 text-xs sm:text-sm p-4 rounded-xl flex items-center gap-2.5">
                    <AppIcon name="triangle-exclamation" class="text-red-400" />
                    <span>{error}</span>
                </div>
            )
        }

        <!-- Search and Filter Toolbar -->
        <div class="bg-bg-secondary border border-white/5 rounded-xl p-3 sm:p-4 flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
            <div class="relative flex-1">
                <AppIcon name="magnifying-glass" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-text-secondary text-xs" />
                <input
                    id="userSearchInput"
                    type="text"
                    placeholder="Buscar por nombre, correo o teléfono..."
                    class="w-full bg-bg-main border border-white/10 focus:border-accent-main rounded-xl pl-9 pr-8 py-2 text-xs sm:text-sm text-white placeholder-text-secondary/50 outline-none transition-colors"
                />
                <button
                    id="clearSearchBtn"
                    type="button"
                    class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-text-secondary hover:text-white p-1 text-xs"
                    title="Limpiar búsqueda"
                >
                    <AppIcon name="xmark" />
                </button>
            </div>

            <div class="flex items-center gap-2">
                <div class="relative min-w-[140px] flex-1 sm:flex-none">
                    <select
                        id="roleFilterSelect"
                        class="w-full bg-bg-main border border-white/10 focus:border-accent-main rounded-xl px-3 py-2 text-xs sm:text-sm text-white appearance-none cursor-pointer outline-none"
                    >
                        <option value="ALL">Todos los roles</option>
                        {
                            roles.map((r: any) => (
                                <option value={r.name}>{r.name}</option>
                            ))
                        }
                    </select>
                    <AppIcon name="chevron-down" class="absolute right-3 top-1/2 -translate-y-1/2 text-text-secondary pointer-events-none text-[10px]" />
                </div>

                <div class="px-3 py-2 rounded-xl bg-white/5 border border-white/5 text-xs text-text-secondary font-mono shrink-0 whitespace-nowrap">
                    <span id="userCount">{users.length}</span> usuarios
                </div>
            </div>
        </div>

        <!-- Mobile Card List View (< md) -->
        <div id="mobileUserList" class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:hidden">
            {
                users.map((user: any) => {
                    const roleName = user.role?.name || "USER";
                    const isAdmin = roleName === "ADMIN";
                    const cleanPhone = user.phoneNumber ? user.phoneNumber.replace(/[^0-9]/g, "") : "";
                    const searchData = `${user.name || ""} ${user.email || ""} ${user.phoneNumber || ""} ${roleName}`.toLowerCase();

                    return (
                        <div
                            class="user-item bg-bg-secondary border border-white/5 rounded-xl p-4 flex flex-col justify-between hover:border-accent-main/40 transition-colors space-y-3"
                            data-search={searchData}
                            data-role={roleName}
                        >
                            <!-- User Header -->
                            <div class="flex items-start justify-between gap-2.5">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <div class="w-9 h-9 rounded-full bg-accent-main/15 text-accent-main flex items-center justify-center font-bold text-xs shrink-0">
                                        {user.name ? user.name.charAt(0).toUpperCase() : "U"}
                                    </div>
                                    <div class="min-w-0">
                                        <h3 class="text-sm font-semibold text-white truncate">
                                            {user.name}
                                        </h3>
                                        <p class="text-[11px] text-text-secondary font-mono">
                                            ID #{user.id}
                                        </p>
                                    </div>
                                </div>

                                <span
                                    class={`px-2 py-0.5 rounded text-[11px] font-mono font-semibold shrink-0 ${
                                        isAdmin
                                            ? "bg-purple-500/15 text-purple-300 border border-purple-500/30"
                                            : "bg-white/5 text-text-secondary border border-white/10"
                                    }`}
                                >
                                    {roleName}
                                </span>
                            </div>

                            <!-- User Info -->
                            <div class="space-y-1.5 text-xs pt-1 border-t border-white/5">
                                <div class="flex items-center gap-2 text-text-secondary truncate">
                                    <AppIcon name="envelope" class="w-4 text-center text-text-secondary/70" />
                                    <span class="truncate">{user.email}</span>
                                </div>

                                <div class="flex items-center justify-between text-text-secondary">
                                    <div class="flex items-center gap-2 truncate">
                                        <AppIcon name="phone" class="w-4 text-center text-text-secondary/70" />
                                        <span>{user.phoneNumber || "Sin teléfono"}</span>
                                    </div>
                                    {cleanPhone && (
                                        <a
                                            href={`https://wa.me/${cleanPhone}`}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="inline-flex items-center gap-1 text-[11px] text-green-400 hover:text-green-300 bg-green-500/10 border border-green-500/20 px-2 py-0.5 rounded-md transition-colors"
                                            title="Abrir chat de WhatsApp"
                                        >
                                            <AppIcon name="whatsapp" class="text-xs" />
                                            <span>WhatsApp</span>
                                        </a>
                                    )}
                                </div>
                            </div>

                            <!-- Mobile Action Buttons -->
                            <div class="pt-2 border-t border-white/5 grid grid-cols-2 gap-2">
                                <button
                                    type="button"
                                    class="edit-btn py-2 px-3 rounded-lg text-xs font-medium text-blue-400 bg-blue-500/10 hover:bg-blue-500/20 border border-blue-500/20 transition-colors flex items-center justify-center gap-1.5"
                                    data-user={JSON.stringify(user)}
                                >
                                    <AppIcon name="pen-to-square" />
                                    <span>Editar</span>
                                </button>
                                <button
                                    type="button"
                                    class="delete-btn py-2 px-3 rounded-lg text-xs font-medium text-red-400 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 transition-colors flex items-center justify-center gap-1.5"
                                    data-id={user.id}
                                    data-name={user.name}
                                >
                                    <AppIcon name="trash" />
                                    <span>Eliminar</span>
                                </button>
                            </div>
                        </div>
                    );
                })
            }
        </div>

        <!-- Desktop Table View (>= md) -->
        <div class="hidden md:block bg-bg-secondary rounded-xl border border-white/5 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-text-main">
                    <thead class="bg-bg-main text-text-secondary uppercase text-[11px] font-mono tracking-wider border-b border-white/5">
                        <tr>
                            <th class="px-5 py-3.5 font-semibold">ID</th>
                            <th class="px-5 py-3.5 font-semibold">Usuario</th>
                            <th class="px-5 py-3.5 font-semibold">Email</th>
                            <th class="px-5 py-3.5 font-semibold">Teléfono</th>
                            <th class="px-5 py-3.5 font-semibold">Rol</th>
                            <th class="px-5 py-3.5 font-semibold text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="desktopUserTbody" class="divide-y divide-white/5">
                        {
                            users.map((user: any) => {
                                const roleName = user.role?.name || "USER";
                                const isAdmin = roleName === "ADMIN";
                                const cleanPhone = user.phoneNumber ? user.phoneNumber.replace(/[^0-9]/g, "") : "";
                                const searchData = `${user.name || ""} ${user.email || ""} ${user.phoneNumber || ""} ${roleName}`.toLowerCase();

                                return (
                                    <tr
                                        class="user-item hover:bg-white/5 transition-colors"
                                        data-search={searchData}
                                        data-role={roleName}
                                    >
                                        <td class="px-5 py-3.5 font-mono text-xs opacity-60">
                                            #{user.id}
                                        </td>
                                        <td class="px-5 py-3.5">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 rounded-full bg-accent-main/15 text-accent-main flex items-center justify-center font-bold text-xs shrink-0">
                                                    {user.name ? user.name.charAt(0).toUpperCase() : "U"}
                                                </div>
                                                <span class="font-medium text-white">
                                                    {user.name}
                                                </span>
                                            </div>
                                        </td>
                                        <td class="px-5 py-3.5 text-text-secondary text-xs">
                                            {user.email}
                                        </td>
                                        <td class="px-5 py-3.5 text-text-secondary text-xs">
                                            <div class="flex items-center gap-2">
                                                <span>{user.phoneNumber || "-"}</span>
                                                {cleanPhone && (
                                                    <a
                                                        href={`https://wa.me/${cleanPhone}`}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="text-green-500 hover:text-green-400 transition-colors p-1"
                                                        title="Enviar WhatsApp"
                                                    >
                                                        <AppIcon name="whatsapp" class="text-sm" />
                                                    </a>
                                                )}
                                            </div>
                                        </td>
                                        <td class="px-5 py-3.5">
                                            <span
                                                class={`px-2.5 py-1 rounded text-xs font-mono font-medium ${
                                                    isAdmin
                                                        ? "bg-purple-500/15 text-purple-300 border border-purple-500/30"
                                                        : "bg-white/5 text-text-secondary border border-white/10"
                                                }`}
                                            >
                                                {roleName}
                                            </span>
                                        </td>
                                        <td class="px-5 py-3.5 text-right">
                                            <div class="inline-flex items-center gap-1.5">
                                                <button
                                                    type="button"
                                                    class="edit-btn p-2 rounded-lg text-text-secondary hover:text-blue-400 hover:bg-white/5 transition-colors"
                                                    data-user={JSON.stringify(user)}
                                                    title="Editar usuario"
                                                >
                                                    <AppIcon name="pen-to-square" class="text-sm" />
                                                </button>
                                                <button
                                                    type="button"
                                                    class="delete-btn p-2 rounded-lg text-text-secondary hover:text-red-400 hover:bg-white/5 transition-colors"
                                                    data-id={user.id}
                                                    data-name={user.name}
                                                    title="Eliminar usuario"
                                                >
                                                    <AppIcon name="trash" class="text-sm" />
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                );
                            })
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- No Results Fallback -->
        <div id="noResultsMessage" class="hidden bg-bg-secondary border border-white/5 rounded-xl p-8 text-center space-y-2">
            <AppIcon name="user-slash" class="text-2xl text-text-secondary/50" />
            <p class="text-sm font-medium text-white">No se encontraron usuarios</p>
            <p class="text-xs text-text-secondary">Intenta con otros términos de búsqueda o cambia el filtro de roles.</p>
        </div>

        <!-- Modal Responsive (Bottom-sheet on mobile, centered dialog on desktop) -->
        <div
            id="userModal"
            class="hidden fixed inset-0 bg-black/75 z-50 items-center justify-center p-3 sm:p-4 backdrop-blur-xs transition-opacity"
            aria-modal="true"
            role="dialog"
        >
            <div
                class="bg-bg-secondary w-full max-w-lg max-h-[90dvh] flex flex-col rounded-2xl shadow-2xl border border-white/10 overflow-hidden animate-in fade-in zoom-in-95 duration-150"
            >
                <!-- Modal Header -->
                <div class="px-5 py-4 border-b border-white/5 flex justify-between items-center bg-bg-main shrink-0">
                    <div class="flex items-center gap-2.5">
                        <div class="w-7 h-7 rounded-lg bg-accent-main/15 text-accent-main flex items-center justify-center text-xs">
                            <AppIcon name="user-gear" />
                        </div>
                        <h3 id="modalTitle" class="text-base font-bold text-white">
                            Nuevo Usuario
                        </h3>
                    </div>
                    <button
                        id="closeModal"
                        type="button"
                        class="text-text-secondary hover:text-white p-1.5 rounded-lg hover:bg-white/5 transition-colors"
                        aria-label="Cerrar modal"
                    >
                        <AppIcon name="xmark" class="text-lg" />
                    </button>
                </div>

                <!-- Modal Form Body -->
                <form id="userForm" class="flex flex-col flex-1 overflow-hidden">
                    <div class="p-5 sm:p-6 space-y-4 overflow-y-auto flex-1">
                        <input type="hidden" name="id" id="userId" />

                        <div>
                            <label class="block text-xs font-medium mb-1.5 text-text-secondary">
                                Nombre completo
                            </label>
                            <input
                                type="text"
                                name="name"
                                required
                                placeholder="Ej: Juan Pérez"
                                class="w-full bg-bg-main border border-white/10 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-white placeholder-text-secondary/40 outline-none focus:border-accent-main transition-colors"
                            />
                        </div>

                        <div>
                            <label class="block text-xs font-medium mb-1.5 text-text-secondary">
                                Correo electrónico
                            </label>
                            <input
                                type="email"
                                name="email"
                                required
                                placeholder="usuario@ejemplo.com"
                                class="w-full bg-bg-main border border-white/10 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-white placeholder-text-secondary/40 outline-none focus:border-accent-main transition-colors"
                            />
                        </div>

                        <div>
                            <label class="block text-xs font-medium mb-1.5 text-text-secondary">
                                Teléfono (WhatsApp)
                            </label>
                            <input
                                type="tel"
                                name="phoneNumber"
                                placeholder="+54 9 11 1234 5678"
                                class="w-full bg-bg-main border border-white/10 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-white placeholder-text-secondary/40 outline-none focus:border-accent-main transition-colors"
                            />
                            <p class="text-[11px] text-text-secondary mt-1">
                                Opcional. Incluye código de país para enlaces directos.
                            </p>
                        </div>

                        <div>
                            <label class="block text-xs font-medium mb-1.5 text-text-secondary">
                                Contraseña
                            </label>
                            <input
                                type="password"
                                name="password"
                                minlength="6"
                                placeholder="Mínimo 6 caracteres"
                                class="w-full bg-bg-main border border-white/10 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-white placeholder-text-secondary/40 outline-none focus:border-accent-main transition-colors"
                            />
                            <p id="passwordHelp" class="text-[11px] text-text-secondary mt-1">
                                Requerido para usuarios nuevos. En edición, dejar en blanco para no cambiar.
                            </p>
                        </div>

                        <div>
                            <label class="block text-xs font-medium mb-1.5 text-text-secondary">
                                Rol asignado
                            </label>
                            <div class="relative">
                                <select
                                    name="roleId"
                                    class="w-full bg-bg-main border border-white/10 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-white appearance-none cursor-pointer outline-none focus:border-accent-main transition-colors"
                                >
                                    {
                                        roles.map((role: any) => (
                                            <option value={role.id}>{role.name}</option>
                                        ))
                                    }
                                </select>
                                <AppIcon name="chevron-down" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-text-secondary pointer-events-none text-xs" />
                            </div>
                        </div>
                    </div>

                    <!-- Modal Footer -->
                    <div class="p-4 sm:p-5 border-t border-white/5 flex items-center justify-end gap-2.5 bg-bg-main/60 shrink-0">
                        <button
                            type="button"
                            id="cancelModalBtn"
                            class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium text-text-secondary hover:text-white hover:bg-white/5 border border-white/5 transition-colors"
                        >
                            Cancelar
                        </button>
                        <button
                            type="submit"
                            id="submitUserBtn"
                            class="bg-accent-main hover:bg-accent-main/90 text-white font-semibold text-xs sm:text-sm px-5 py-2.5 rounded-xl shadow-md transition-colors"
                        >
                            Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</AdminLayout>

<script>
    import { showError, showSuccessToast, showConfirm } from "@/utils/alerts";

    const pageContainer = document.getElementById("users-page");
    const API_URL = pageContainer?.dataset.apiUrl || "http://localhost:3000/api";
    const TOKEN = pageContainer?.dataset.token;

    const modal = document.getElementById("userModal");
    const form = document.getElementById("userForm") as HTMLFormElement;
    const modalTitle = document.getElementById("modalTitle");
    const openBtn = document.getElementById("openCreateModal");
    const closeBtn = document.getElementById("closeModal");
    const cancelBtn = document.getElementById("cancelModalBtn");
    const passwordHelp = document.getElementById("passwordHelp");
    const passwordInput = document.querySelector('[name="password"]') as HTMLInputElement;

    // Search and filter elements
    const searchInput = document.getElementById("userSearchInput") as HTMLInputElement;
    const clearSearchBtn = document.getElementById("clearSearchBtn");
    const roleFilterSelect = document.getElementById("roleFilterSelect") as HTMLSelectElement;
    const userCountEl = document.getElementById("userCount");
    const noResultsEl = document.getElementById("noResultsMessage");
    const userItems = document.querySelectorAll(".user-item") as NodeListOf<HTMLElement>;

    // Filter Logic
    function applyUserFilters() {
        const query = searchInput?.value.trim().toLowerCase() || "";
        const selectedRole = roleFilterSelect?.value || "ALL";

        let visibleCount = 0;

        userItems.forEach((item) => {
            const itemSearch = item.dataset.search || "";
            const itemRole = item.dataset.role || "";

            const matchesQuery = !query || itemSearch.includes(query);
            const matchesRole = selectedRole === "ALL" || itemRole === selectedRole;

            if (matchesQuery && matchesRole) {
                item.style.display = "";
                visibleCount++;
            } else {
                item.style.display = "none";
            }
        });

        // Update clear button
        if (clearSearchBtn) {
            clearSearchBtn.classList.toggle("hidden", query.length === 0);
        }

        // Update count (divided by 2 since elements exist in mobile cards and desktop table)
        const effectiveCount = window.innerWidth >= 768 ? visibleCount : visibleCount;
        // Count unique visible items by id or simply count visible in either container
        const visibleMobile = document.querySelectorAll("#mobileUserList .user-item:not([style*='display: none'])").length;
        const visibleDesktop = document.querySelectorAll("#desktopUserTbody .user-item:not([style*='display: none'])").length;
        const finalCount = window.innerWidth >= 768 ? visibleDesktop : visibleMobile;

        if (userCountEl) {
            userCountEl.textContent = String(finalCount);
        }

        if (noResultsEl) {
            noResultsEl.classList.toggle("hidden", finalCount > 0);
        }
    }

    searchInput?.addEventListener("input", applyUserFilters);
    roleFilterSelect?.addEventListener("change", applyUserFilters);

    clearSearchBtn?.addEventListener("click", () => {
        if (searchInput) {
            searchInput.value = "";
            applyUserFilters();
            searchInput.focus();
        }
    });

    // Modal Helpers
    const toggleModal = (show: boolean) => {
        if (show) {
            modal?.classList.remove("hidden");
            modal?.classList.add("flex");
            document.body.classList.add("overflow-hidden");
        } else {
            modal?.classList.add("hidden");
            modal?.classList.remove("flex");
            document.body.classList.remove("overflow-hidden");
        }
    };

    openBtn?.addEventListener("click", () => {
        form.reset();
        document.getElementById("userId")?.setAttribute("value", "");
        if (modalTitle) modalTitle.textContent = "Nuevo Usuario";
        if (passwordInput) passwordInput.required = true;
        if (passwordHelp) passwordHelp.textContent = "Requerido para usuarios nuevos (mínimo 6 caracteres).";
        toggleModal(true);
    });

    closeBtn?.addEventListener("click", () => toggleModal(false));
    cancelBtn?.addEventListener("click", () => toggleModal(false));

    // Close modal on click outside backdrop
    modal?.addEventListener("click", (e) => {
        if (e.target === modal) {
            toggleModal(false);
        }
    });

    // Close on escape
    window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
            toggleModal(false);
        }
    });

    // Edit button click listeners (attached to both mobile cards and table rows)
    document.querySelectorAll(".edit-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            const raw = btn.getAttribute("data-user");
            if (!raw) return;
            const userData = JSON.parse(raw);

            if (modalTitle) modalTitle.textContent = "Editar Usuario";
            if (passwordInput) passwordInput.required = false;
            if (passwordHelp) passwordHelp.textContent = "Dejar en blanco si no deseas cambiar la contraseña actual.";

            const nameInput = document.querySelector('[name="name"]') as HTMLInputElement;
            const emailInput = document.querySelector('[name="email"]') as HTMLInputElement;
            const phoneInput = document.querySelector('[name="phoneNumber"]') as HTMLInputElement;
            const roleSelect = document.querySelector('[name="roleId"]') as HTMLSelectElement;
            const idInput = document.getElementById("userId") as HTMLInputElement;

            if (nameInput) nameInput.value = userData.name || "";
            if (emailInput) emailInput.value = userData.email || "";
            if (phoneInput) phoneInput.value = userData.phoneNumber || "";
            if (roleSelect) roleSelect.value = String(userData.roleId || "");
            if (idInput) idInput.value = String(userData.id);

            toggleModal(true);
        });
    });

    // Delete buttons
    document.querySelectorAll(".delete-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
            const id = btn.getAttribute("data-id");
            const name = btn.getAttribute("data-name") || "este usuario";
            if (!id) return;

            const confirmed = await showConfirm(
                `¿Eliminar a ${name}?`,
                "Esta acción no se puede deshacer y revocará sus permisos.",
                "Sí, eliminar",
                "Cancelar"
            );
            if (!confirmed.isConfirmed) return;

            try {
                const res = await fetch(`${API_URL}/users/${id}`, {
                    method: "DELETE",
                    headers: {
                        Authorization: `Bearer ${TOKEN}`,
                    },
                });

                if (res.ok) {
                    await showSuccessToast("Usuario eliminado correctamente");
                    window.location.reload();
                } else {
                    const err = await res.json().catch(() => ({}));
                    showError("Error", err.error || "No se pudo eliminar el usuario");
                }
            } catch (e) {
                console.error(e);
                showError("Error de Conexión", "No se pudo contactar con el servidor");
            }
        });
    });

    // Form Submit
    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById("submitUserBtn") as HTMLButtonElement;
        const originalText = submitBtn ? submitBtn.innerText : "Guardar";

        const formData = new FormData(form);
        const id = formData.get("id");
        const isEdit = !!id;

        const data: any = {};
        formData.forEach((value, key) => (data[key] = value));

        if (!data.password) {
            delete data.password;
        }

        const endpoint = isEdit ? `${API_URL}/users/${id}` : `${API_URL}/users`;
        const method = isEdit ? "PUT" : "POST";

        try {
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerText = "Guardando...";
            }

            const res = await fetch(endpoint, {
                method,
                headers: {
                    "Content-Type": "application/json",
                    Authorization: `Bearer ${TOKEN}`,
                },
                body: JSON.stringify(data),
            });

            if (res.ok) {
                await showSuccessToast(
                    isEdit ? "Usuario actualizado correctamente" : "Usuario creado con éxito",
                );
                window.location.reload();
            } else {
                const err = await res.json().catch(() => ({}));
                showError("Error al Guardar", err.error || "Verifica los datos ingresados");
            }
        } catch (e) {
            console.error(e);
            showError("Error de Conexión", "No se pudo conectar con el servidor.");
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerText = originalText;
            }
        }
    });
</script>
