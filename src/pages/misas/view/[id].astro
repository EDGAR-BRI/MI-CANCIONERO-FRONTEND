---
import Layout from "../../../layouts/Layout.astro";
import type { Misa, Moment } from "../../../types/misa";
import { getMoments } from "../../../services/moments";
import { getUserFromToken } from "../../../utils/auth";
import SongView from "../../../components/SongView.jsx";
import HeaderLyric from "../../../components/HeaderLyric.astro";
import MisaAutoScrollReact from "@/components/MisaAutoScrollReact.jsx";
import { API_URL } from "@/services/songs";

const { id } = Astro.params;

let misa: Misa | null = null;
let error: string | null = null;
let isForbidden = false;
let ministryName: string | null = null;
let moments: Moment[] = [];
let token = Astro.cookies.get("token")?.value;
const user = getUserFromToken(token);

if (id) {
    try {
        const headers: Record<string, string> = {};
        if (token) headers["Authorization"] = `Bearer ${token}`;

        const url = `${API_URL}/misas/${id}`;

        const [misaRes, momentsRes] = await Promise.all([
            fetch(url, { headers }),
            getMoments(),
        ]);

        if (misaRes.ok) {
            misa = await misaRes.json();
        } else {
            const errData = await misaRes.json().catch(() => null);
            if (misaRes.status === 403) {
                isForbidden = true;
                ministryName = errData?.ministryName || null;
                error = errData?.error || "Esta misa es privada.";
            } else if (misaRes.status === 404) {
                error = "La misa solicitada no existe.";
            } else {
                error = errData?.error || "No se pudo cargar la misa.";
            }
        }

        if (momentsRes.success && momentsRes.data) {
            moments = momentsRes.data;
        }
    } catch (e) {
        error = "Error al conectar con el servidor.";
    }
} else {
    error = "Identificador de misa no válido.";
}

// Compute datePart and timePart to match MisaDetailReact exactly
let datePart = "";
let timePart = "";
if (misa?.dateMisa) {
    const d = new Date(misa.dateMisa);
    if (!isNaN(d.getTime())) {
        datePart = d.toLocaleDateString("es-ES", {
            weekday: "long",
            year: "numeric",
            month: "long",
            day: "numeric",
        });
        const hours = d.getHours();
        const minutes = d.getMinutes();
        if (hours !== 0 || minutes !== 0) {
            timePart = d.toLocaleTimeString("es-ES", {
                hour: "2-digit",
                minute: "2-digit",
                hour12: true,
            });
        }
    } else {
        datePart = misa.dateMisa;
    }
}

// Filter and group moments that actually have songs assigned
const momentsWithSongs = (
    misa?.misaMoments && misa.misaMoments.length > 0
        ? misa.misaMoments.map((mm) => mm.moment)
        : moments
)
    .map((moment) => {
        const songs = (misa?.misaSongs || []).filter(
            (ms) => ms.momentId === moment.id,
        );
        return {
            moment,
            songs,
        };
    })
    .filter((item) => item.songs.length > 0);

const totalSongsCount = momentsWithSongs.reduce((acc, curr) => acc + curr.songs.length, 0);
---

<Layout title={misa ? `${misa.title} - Modo Lectura` : (isForbidden ? "Misa Privada" : "Misa no disponible")}>
    <div class="print-header">
        <img
            src="/icono-light.svg"
            alt="Cancionero Digital"
            class="print-logo"
        />
        <div>
            <h1
                class="text-2xl font-bold bg-clip-text text-transparent bg-linear-to-r from-accent-main to-accent-light"
            >
                {misa?.title}
            </h1>
            <p class="text-gray-500 text-sm">Generado por Cancionero Digital</p>
        </div>
    </div>

    <main class="w-full max-w-5xl mx-auto px-3 sm:px-4 py-4 sm:py-8 flex-1 flex flex-col">
        {
            isForbidden ? (
                <div class="bg-bg-secondary border border-white/5 rounded-2xl p-8 sm:p-12 text-center my-auto max-w-md mx-auto space-y-5 shadow-xl">
                    <div class="w-14 h-14 rounded-2xl bg-white/5 text-amber-400 flex items-center justify-center mx-auto text-2xl border border-white/10">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                    <div class="space-y-2">
                        <h2 class="text-xl font-bold text-white">Misa Privada</h2>
                        {ministryName ? (
                            <p class="text-xs text-text-secondary leading-relaxed">
                                Esta misa pertenece al grupo <strong class="text-white">{ministryName}</strong> y solo sus miembros activos tienen acceso.
                            </p>
                        ) : (
                            <p class="text-xs text-text-secondary leading-relaxed">
                                {error || "Esta misa es privada y solo su creador tiene acceso."}
                            </p>
                        )}
                    </div>
                    {user ? (
                        <p class="text-xs text-text-secondary/70">
                            Sesión iniciada como <span class="text-white font-mono">{user.name || user.email}</span>
                        </p>
                    ) : (
                        <p class="text-xs text-text-secondary/80">
                            Si perteneces a este grupo, inicia sesión con tu cuenta para acceder.
                        </p>
                    )}
                    <div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
                        {!user && (
                            <a
                                href={`/login?redirect=/misas/view/${id}`}
                                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-accent-main hover:bg-accent-main/90 text-white font-bold text-xs transition-colors shadow-md"
                            >
                                <i class="fa-solid fa-right-to-bracket text-xs"></i>
                                <span>Iniciar Sesión</span>
                            </a>
                        )}
                        <a
                            href="/misas"
                            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-white border border-white/10 font-bold text-xs transition-colors"
                        >
                            <i class="fa-solid fa-arrow-left text-xs"></i>
                            <span>Volver a Misas</span>
                        </a>
                    </div>
                </div>
            ) : error || !misa ? (
                <div class="bg-bg-secondary border border-white/5 rounded-2xl p-8 sm:p-12 text-center my-auto max-w-md mx-auto space-y-4 shadow-xl">
                    <div class="w-12 h-12 rounded-full bg-red-500/10 text-red-400 flex items-center justify-center mx-auto text-xl">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div class="space-y-1">
                        <h2 class="text-xl font-bold text-white">Misa no disponible</h2>
                        <p class="text-xs text-text-secondary">{error || "No se pudo cargar la información."}</p>
                    </div>
                    <a
                        href="/misas"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-accent-main hover:bg-accent-main/90 text-white font-bold text-xs transition-colors shadow-md"
                    >
                        <i class="fa-solid fa-arrow-left text-xs"></i>
                        <span>Volver a Misas</span>
                    </a>
                </div>
            ) : (
                <div class="w-full flex flex-col gap-6 pb-24 md:pb-12">
                    {/* Header & Breadcrumb */}
                    <div class="flex flex-col gap-4">
                        <div class="flex items-center justify-between gap-2 sm:gap-3 no-print">
                            <a
                                href="/misas"
                                style="view-transition-name: misa-back-btn;"
                                class="inline-flex items-center gap-1.5 sm:gap-2 text-xs font-semibold text-text-secondary hover:text-accent-main transition-colors group shrink-0"
                            >
                                <i class="fa-solid fa-arrow-left transition-transform group-hover:-translate-x-1"></i>
                                <span class="sm:hidden">Volver</span>
                                <span class="hidden sm:inline">Volver a Misas</span>
                            </a>

                            <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
                                {/* Switch entre Modo Edición y Modo Lectura */}
                                <div
                                    style="view-transition-name: misa-view-switch;"
                                    class="bg-bg-secondary border border-white/10 p-0.5 rounded-xl flex items-center text-xs"
                                >
                                    <a
                                        href={`/misas/${id}`}
                                        data-astro-prefetch="hover"
                                        class="px-2 sm:px-3 py-1 rounded-lg text-text-secondary hover:text-white hover:bg-white/5 font-medium transition-colors flex items-center gap-1.5"
                                        title="Cambiar a Modo Edición y gestión"
                                    >
                                        <i class="fa-solid fa-pen-to-square text-[10px] sm:text-xs"></i>
                                        <span>Edición</span>
                                    </a>
                                    <span
                                        style="view-transition-name: misa-switch-pill;"
                                        class="px-2 sm:px-3 py-1 rounded-lg bg-accent-main text-white font-bold flex items-center gap-1.5 shadow-sm"
                                        title="Vista actual: Modo Lectura"
                                    >
                                        <i class="fa-solid fa-book-open text-[10px] sm:text-xs"></i>
                                        <span>Lectura</span>
                                    </span>
                                </div>

                                {/* Visibility indicator */}
                                <span
                                    style="view-transition-name: misa-privacy-badge;"
                                    class={`text-xs px-2 sm:px-2.5 py-1 rounded-full font-medium inline-flex items-center gap-1 sm:gap-1.5 border ${
                                        misa.visibility === "PUBLIC"
                                            ? "bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
                                            : "bg-white/5 text-text-secondary border-white/10"
                                    }`}
                                >
                                    <i
                                        class={`fa-solid ${
                                            misa.visibility === "PUBLIC" ? "fa-globe" : "fa-lock"
                                        } text-[10px]`}
                                    ></i>
                                    <span>{misa.visibility === "PUBLIC" ? "Pública" : "Privada"}</span>
                                </span>
                            </div>
                        </div>

                        {/* Title & Celebration Meta */}
                        <div
                            style="view-transition-name: misa-header-card;"
                            class="bg-bg-secondary border border-white/5 rounded-2xl p-4 sm:p-7 shadow-xl"
                        >
                            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5">
                                <div class="space-y-2">
                                    {misa.ministry && (
                                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-main/10 border border-accent-main/20 text-accent-main text-xs font-semibold">
                                            <i class="fa-solid fa-users text-xs"></i>
                                            <span>{misa.ministry.name}</span>
                                        </div>
                                    )}
                                    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-snug">
                                        {misa.title}
                                    </h1>
                                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs sm:text-sm text-text-secondary">
                                        <span class="flex items-center gap-1.5 capitalize">
                                            <i class="fa-solid fa-calendar-day text-accent-main"></i>
                                            <span>{datePart}</span>
                                        </span>
                                        {timePart && (
                                            <span class="flex items-center gap-1.5 font-medium text-white/90">
                                                <i class="fa-solid fa-clock text-accent-main"></i>
                                                <span>{timePart}</span>
                                            </span>
                                        )}
                                        {misa.user?.name && (
                                            <span class="flex items-center gap-1.5 text-text-secondary/80">
                                                <i class="fa-solid fa-user text-xs"></i>
                                                <span>{misa.user.name}</span>
                                            </span>
                                        )}
                                        {totalSongsCount > 0 && (
                                            <span class="flex items-center gap-1.5 text-text-secondary/70">
                                                <i class="fa-solid fa-music text-xs"></i>
                                                <span>{totalSongsCount} {totalSongsCount === 1 ? 'canto' : 'cantos'}</span>
                                            </span>
                                        )}
                                    </div>
                                </div>

                                <div class="grid grid-cols-3 sm:flex sm:items-center gap-2 w-full lg:w-auto no-print">
                                    <div
                                        class="relative w-full sm:w-auto"
                                        id="pdfDropdownContainer"
                                        data-misa-id={id}
                                        data-misa-title={misa?.title}
                                        data-misa-date={misa?.dateMisa}
                                    >
                                        <button
                                            id="pdfDropdownBtn"
                                            type="button"
                                            class="w-full sm:w-auto h-9 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-text-secondary hover:text-white border border-white/10 text-xs font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-sm active:scale-95 group focus:outline-none whitespace-nowrap"
                                            title="Descargar Misa en formato PDF"
                                            aria-expanded="false"
                                            aria-haspopup="true"
                                        >
                                            <i class="fa-solid fa-file-pdf text-[11px] text-text-secondary group-hover:text-white transition-colors" id="pdfBtnIcon"></i>
                                            <span id="pdfBtnText">Descargar</span>
                                            <i class="fa-solid fa-chevron-down text-[9px] opacity-70 group-hover:opacity-100 transition-transform duration-200" id="pdfChevron"></i>
                                        </button>
                                        <div
                                            id="pdfDropdownMenu"
                                            class="hidden absolute left-0 sm:left-auto sm:right-0 mt-2 w-full sm:w-52 rounded-xl bg-bg-secondary border border-white/10 shadow-2xl py-1.5 z-50 text-xs"
                                        >
                                            <button
                                                type="button"
                                                id="downloadPdfChordsBtn"
                                                class="w-full text-left px-3.5 py-2 hover:bg-white/5 text-white flex items-center gap-2.5 transition-colors cursor-pointer group"
                                            >
                                                <i class="fa-solid fa-guitar text-accent-main w-4 text-center"></i>
                                                <div>
                                                    <div class="font-bold text-white group-hover:text-accent-main transition-colors">Con Acordes</div>
                                                    <div class="text-[10px] text-text-secondary">Para músicos</div>
                                                </div>
                                            </button>
                                            <button
                                                type="button"
                                                id="downloadPdfLyricsBtn"
                                                class="w-full text-left px-3.5 py-2 hover:bg-white/5 text-white flex items-center gap-2.5 transition-colors cursor-pointer border-t border-white/5 group"
                                            >
                                                <i class="fa-solid fa-align-left text-accent-main w-4 text-center"></i>
                                                <div>
                                                    <div class="font-bold text-white group-hover:text-accent-main transition-colors">Solo Letra</div>
                                                    <div class="text-[10px] text-text-secondary">Para coro</div>
                                                </div>
                                            </button>
                                        </div>
                                    </div>

                                    <button
                                        id="toggleChordsBtn"
                                        type="button"
                                        aria-pressed="false"
                                        title="Mostrar acordes en pantalla"
                                        class="w-full sm:w-auto h-9 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-text-secondary hover:text-white border border-white/10 text-xs font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-sm active:scale-95 group focus:outline-none whitespace-nowrap"
                                    >
                                        <i class="fa-solid fa-music text-[11px] text-text-secondary group-hover:text-white transition-colors"></i>
                                        <span>Acordes</span>
                                    </button>

                                    {/* Auto-scroll para la lectura de la misa */}
                                    <MisaAutoScrollReact client:load />
                                </div>
                            </div>
                        </div>
                    </div>

                    {/* Quick Moment Navigation Pills (Índice Rápido) */}
                    {momentsWithSongs.length > 0 && (
                        <div class="no-print flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-bg-secondary/40 border border-white/5 p-3 sm:px-4 rounded-xl">
                            <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0 max-w-full scrollbar-none">
                                <span class="text-xs text-text-secondary font-medium uppercase tracking-wider shrink-0 flex items-center gap-1.5 mr-1">
                                    <i class="fa-solid fa-list-ul text-accent-main"></i>
                                    <span>Momentos:</span>
                                </span>
                                {momentsWithSongs.map(({ moment, songs }) => (
                                    <button
                                        type="button"
                                        data-moment-target={`moment-section-${moment.id}`}
                                        class="moment-jump-btn shrink-0 px-3 py-1.5 rounded-full text-xs font-medium bg-bg-secondary text-text-secondary hover:text-white hover:bg-white/10 border border-white/5 transition-colors cursor-pointer flex items-center gap-1.5"
                                        title={`Ir al momento: ${moment.nombre}`}
                                    >
                                        <span>{moment.nombre}</span>
                                        <span class="text-[10px] opacity-60 font-mono">({songs.length})</span>
                                    </button>
                                ))}
                            </div>

                            <button
                                id="toggleAllMomentsBtn"
                                type="button"
                                class="shrink-0 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-text-secondary hover:text-white border border-white/10 text-xs font-semibold transition-colors flex items-center justify-center gap-1.5 cursor-pointer sm:ml-auto"
                                title="Expandir o colapsar todos los momentos"
                            >
                                <i class="fa-solid fa-arrows-up-down text-xs text-accent-main"></i>
                                <span id="toggleAllMomentsText">Colapsar todos</span>
                            </button>
                        </div>
                    )}

                    {/* Moments and Songs (Listas desplegables / Acordeón) */}
                    <div class="space-y-4 sm:space-y-5">
                        {momentsWithSongs.length === 0 ? (
                            <div class="bg-bg-secondary border border-white/5 rounded-xl p-8 text-center text-text-secondary space-y-2">
                                <i class="fa-solid fa-music text-2xl text-text-secondary/50"></i>
                                <p class="text-sm">Esta misa aún no tiene cantos asignados en ningún momento litúrgico.</p>
                                <a href={`/misas/${id}`} class="inline-flex items-center gap-1.5 text-xs text-accent-main hover:underline font-semibold mt-2">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                    <span>Ir al Modo Edición para agregar cantos</span>
                                </a>
                            </div>
                        ) : (
                            momentsWithSongs.map(({ moment, songs }) => (
                                <details
                                    id={`moment-section-${moment.id}`}
                                    open
                                    class="moment-details group bg-bg-secondary border border-white/5 rounded-xl overflow-hidden transition-colors shadow-sm scroll-mt-24"
                                >
                                    <summary
                                        class="px-3.5 py-3 sm:px-5 sm:py-3.5 flex items-center justify-between cursor-pointer select-none hover:bg-white/[0.02] transition-colors list-none"
                                    >
                                        <div class="flex items-center gap-2.5 flex-wrap">
                                            <i class="fa-solid fa-layer-group text-accent-main text-xs"></i>
                                            <h2 class="text-sm sm:text-base font-bold text-white uppercase tracking-wider group-hover:text-accent-main transition-colors">
                                                {moment.nombre}
                                            </h2>
                                            <span class="px-2 py-0.5 rounded-full bg-white/5 border border-white/10 text-[11px] font-mono text-text-secondary">
                                                {songs.length} {songs.length === 1 ? 'canto' : 'cantos'}
                                            </span>
                                        </div>

                                        <div class="flex items-center gap-3">
                                            <span class="text-xs text-text-secondary/70 group-hover:text-text-secondary hidden sm:inline transition-colors">
                                                <span class="group-open:hidden">Desplegar</span>
                                                <span class="hidden group-open:inline">Plegar</span>
                                            </span>
                                            <div class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center text-text-secondary group-hover:text-white group-hover:bg-white/10 transition-all border border-white/5">
                                                <i class="fa-solid fa-chevron-down text-xs transition-transform duration-200 group-open:rotate-180"></i>
                                            </div>
                                        </div>
                                    </summary>

                                    <div class="divide-y divide-white/5 border-t border-white/5">
                                        {songs.map((ms) => (
                                            <article class="px-3.5 py-4 sm:px-5 sm:py-5 space-y-3">
                                                <HeaderLyric
                                                    title={ms.song.title}
                                                    tone={
                                                        ms.key ||
                                                        ms.song.key
                                                    }
                                                    showAuthor={false}
                                                />
                                                <SongView
                                                    client:load
                                                    initialContent={
                                                        ms.song.content
                                                    }
                                                    initialKey={
                                                        ms.key || ms.song.key
                                                    }
                                                    originalKey={ms.song.key}
                                                    initialShowChords={false}
                                                    className="pb-2"
                                                />
                                            </article>
                                        ))}
                                    </div>
                                </details>
                            ))
                        )}
                    </div>
                </div>
            )
        }
    </main>

    <script>
        import { showError, showSuccessToast } from "@/utils/alerts";
        import { API_URL } from "@/services/songs";
        import { getChordsPreference, setChordsPreference } from "@/utils/preferences";

        let isChordsActive = false;
        let isDownloadingPdf = false;

        const updateChordsBtnUI = (btn: HTMLElement, active: boolean) => {
            const icon = btn.querySelector("i");
            if (active) {
                btn.classList.remove("bg-white/5", "hover:bg-white/10", "text-text-secondary", "border-white/10");
                btn.classList.add("bg-accent-main", "hover:bg-accent-main/90", "text-white", "border-transparent", "shadow-md");
                btn.setAttribute("aria-pressed", "true");
                btn.title = "Ocultar acordes en pantalla";
                if (icon) {
                    icon.classList.remove("text-text-secondary", "group-hover:text-white");
                    icon.classList.add("text-white");
                }
            } else {
                btn.classList.remove("bg-accent-main", "hover:bg-accent-main/90", "border-transparent", "shadow-md");
                btn.classList.add("bg-white/5", "hover:bg-white/10", "text-text-secondary", "border-white/10");
                btn.setAttribute("aria-pressed", "false");
                btn.title = "Mostrar acordes en pantalla";
                if (icon) {
                    icon.classList.remove("text-white");
                    icon.classList.add("text-text-secondary", "group-hover:text-white");
                }
            }
        };

        const downloadMisaPdf = async (misaId: string, withChords: boolean) => {
            if (isDownloadingPdf) return;
            isDownloadingPdf = true;

            const pdfBtn = document.getElementById("pdfDropdownBtn") as HTMLButtonElement | null;
            const pdfBtnIcon = document.getElementById("pdfBtnIcon");
            const pdfBtnText = document.getElementById("pdfBtnText");
            const originalIconClass = pdfBtnIcon ? pdfBtnIcon.className : "fa-solid fa-file-pdf";
            const originalText = pdfBtnText ? pdfBtnText.textContent : "Descargar";

            if (pdfBtn) pdfBtn.disabled = true;
            if (pdfBtnIcon) pdfBtnIcon.className = "fa-solid fa-spinner fa-spin";
            if (pdfBtnText) pdfBtnText.textContent = "Generando...";

            try {
                const url = `${API_URL}/misas/${misaId}/pdf?chords=${withChords}&download=true`;
                const res = await fetch(url, {
                    credentials: "include"
                });

                if (res.status === 429) {
                    const data = await res.json().catch(() => ({}));
                    const retryAfter = data.retryAfter || 300;
                    const mins = Math.ceil(retryAfter / 60);
                    showError(
                        "Límite de descargas alcanzado",
                        data.error || `Has alcanzado el límite de descargas (máximo 3 cada 5 minutos). Por favor espera ${mins} ${mins === 1 ? "minuto" : "minutos"} antes de volver a descargar.`
                    );
                    return;
                }

                if (res.status === 403) {
                    const data = await res.json().catch(() => ({}));
                    showError("Misa Privada", data.error || "No tienes permisos para descargar el PDF de esta misa.");
                    return;
                }

                if (!res.ok) {
                    const data = await res.json().catch(() => ({}));
                    showError("Error al generar PDF", data.error || "Ocurrió un error inesperado al generar el archivo.");
                    return;
                }

                // Extraer nombre de archivo si viene en Content-Disposition
                let filename = "";
                const disposition = res.headers.get("Content-Disposition");
                if (disposition) {
                    const utf8Match = disposition.match(/filename\*=UTF-8''([^;]+)/i);
                    if (utf8Match && utf8Match[1]) {
                        try {
                            filename = decodeURIComponent(utf8Match[1].trim().replace(/^["']|["']$/g, ""));
                        } catch (_) {}
                    }
                    if (!filename) {
                        const match = disposition.match(/filename="?([^";]+)"?/i);
                        if (match && match[1]) {
                            filename = match[1].trim();
                        }
                    }
                }

                if (!filename) {
                    const pdfContainer = document.getElementById("pdfDropdownContainer");
                    const rawTitle = (pdfContainer?.getAttribute("data-misa-title") || "Misa").trim();
                    const rawDate = pdfContainer?.getAttribute("data-misa-date") || "";
                    const hasMisaPrefix = /^misa\b/i.test(rawTitle);
                    const cleanTitle = rawTitle
                        .normalize("NFD")
                        .replace(/[\u0300-\u036f]/g, "")
                        .replace(/[^a-zA-Z0-9_\-]/g, "_")
                        .replace(/_+/g, "_")
                        .replace(/^_|_$/g, "");
                    const baseName = hasMisaPrefix ? cleanTitle : `Misa_${cleanTitle}`;

                    let datePart = "";
                    if (rawDate) {
                        const d = new Date(rawDate);
                        if (!isNaN(d.getTime())) {
                            const year = d.getFullYear();
                            const month = String(d.getMonth() + 1).padStart(2, "0");
                            const day = String(d.getDate()).padStart(2, "0");
                            datePart = `${year}-${month}-${day}`;
                        }
                    }

                    const suffix = withChords ? "acordes" : "letra";
                    filename = datePart
                        ? `${baseName}_${datePart}_${suffix}.pdf`
                        : `${baseName}_${suffix}.pdf`;
                }

                const blob = await res.blob();
                const blobUrl = window.URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = blobUrl;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(blobUrl);

                showSuccessToast("PDF descargado correctamente", filename);
            } catch (err: any) {
                showError("Error de conexión", "No se pudo conectar con el servidor para descargar el PDF.");
            } finally {
                isDownloadingPdf = false;
                if (pdfBtn) pdfBtn.disabled = false;
                if (pdfBtnIcon) pdfBtnIcon.className = originalIconClass;
                if (pdfBtnText) pdfBtnText.textContent = originalText;
            }
        };

        const setupViewEvents = () => {
            // PDF Dropdown Menu
            const pdfContainer = document.getElementById("pdfDropdownContainer");
            const pdfDropdownBtn = document.getElementById("pdfDropdownBtn");
            const pdfDropdownMenu = document.getElementById("pdfDropdownMenu");
            const pdfChevron = document.getElementById("pdfChevron");
            const downloadPdfChordsBtn = document.getElementById("downloadPdfChordsBtn");
            const downloadPdfLyricsBtn = document.getElementById("downloadPdfLyricsBtn");

            const misaId = pdfContainer?.getAttribute("data-misa-id") ||
                window.location.pathname.split("/").filter(Boolean).pop();

            const closePdfMenu = () => {
                pdfDropdownMenu?.classList.add("hidden");
                pdfChevron?.classList.remove("rotate-180");
                pdfDropdownBtn?.setAttribute("aria-expanded", "false");
            };

            const togglePdfMenu = () => {
                const isClosed = pdfDropdownMenu?.classList.contains("hidden");
                if (isClosed) {
                    pdfDropdownMenu?.classList.remove("hidden");
                    pdfChevron?.classList.add("rotate-180");
                    pdfDropdownBtn?.setAttribute("aria-expanded", "true");
                } else {
                    closePdfMenu();
                }
            };

            if (pdfDropdownBtn && pdfDropdownMenu) {
                pdfDropdownBtn.onclick = (e) => {
                    e.stopPropagation();
                    togglePdfMenu();
                };

                downloadPdfChordsBtn?.addEventListener("click", () => {
                    closePdfMenu();
                    if (misaId) downloadMisaPdf(misaId, true);
                });

                downloadPdfLyricsBtn?.addEventListener("click", () => {
                    closePdfMenu();
                    if (misaId) downloadMisaPdf(misaId, false);
                });

                document.addEventListener("click", (e) => {
                    if (pdfContainer && !pdfContainer.contains(e.target as Node)) {
                        closePdfMenu();
                    }
                });
            }

            // Chords toggle
            const toggleChordsBtn = document.getElementById("toggleChordsBtn");
            if (toggleChordsBtn) {
                isChordsActive = getChordsPreference(false);
                updateChordsBtnUI(toggleChordsBtn, isChordsActive);
                if (isChordsActive) {
                    window.dispatchEvent(
                        new CustomEvent("song-toggle-chords", {
                            detail: { show: true },
                        })
                    );
                }

                toggleChordsBtn.onclick = () => {
                    isChordsActive = !isChordsActive;
                    updateChordsBtnUI(toggleChordsBtn, isChordsActive);
                    setChordsPreference(isChordsActive);
                    window.dispatchEvent(
                        new CustomEvent("song-toggle-chords", {
                            detail: { show: isChordsActive },
                        })
                    );
                };
            }

            // Moment quick navigation jump pills
            document.querySelectorAll(".moment-jump-btn").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const targetId = btn.getAttribute("data-moment-target");
                    if (!targetId) return;
                    const targetEl = document.getElementById(targetId);
                    if (targetEl) {
                        if (targetEl.tagName === "DETAILS" && !targetEl.hasAttribute("open")) {
                            targetEl.setAttribute("open", "true");
                        }
                        targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
                    }
                });
            });

            // Toggle Expand / Collapse all moments
            const toggleAllBtn = document.getElementById("toggleAllMomentsBtn");
            const toggleAllText = document.getElementById("toggleAllMomentsText");
            if (toggleAllBtn) {
                let allExpanded = true;
                toggleAllBtn.onclick = () => {
                    const allDetails = document.querySelectorAll<HTMLDetailsElement>("details.moment-details");
                    allExpanded = !allExpanded;
                    allDetails.forEach((d) => {
                        if (allExpanded) {
                            d.setAttribute("open", "true");
                        } else {
                            d.removeAttribute("open");
                        }
                    });
                    if (toggleAllText) {
                        toggleAllText.textContent = allExpanded ? "Colapsar todos" : "Expandir todos";
                    }
                };
            }
        };

        document.addEventListener("astro:page-load", setupViewEvents);
    </script>
</Layout>
