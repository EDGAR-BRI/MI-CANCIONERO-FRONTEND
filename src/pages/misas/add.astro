---
import Layout from "@/layouts/Layout.astro";
import CreateMisaModal from "@/components/CreateMisaModal";
import { getUserFromToken } from "@/utils/auth";

const token = Astro.cookies.get("token")?.value;
const user = getUserFromToken(token);

if (!user || !token) {
    return Astro.redirect("/login?redirect=/misas/add");
}

const defaultMinistryId = Astro.url.searchParams.get("ministryId") || "";
---

<Layout title="Crear Nueva Misa - CancioneroDigital">
    <main class="min-h-[75vh] flex items-center justify-center px-2 py-4 sm:p-4">
        <CreateMisaModal
            client:load
            isOpen={true}
            onClose={() => {
                window.location.href = "/misas";
            }}
            token={token}
            currentUser={user}
            defaultMinistryId={defaultMinistryId}
            redirectToCreated={true}
        />
    </main>
</Layout>
