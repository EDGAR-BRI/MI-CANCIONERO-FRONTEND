---
// export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import MisaListReact from "@/components/MisaListReact";

const token = Astro.cookies.get("token")?.value;
---

<Layout title="Misas - CancioneroDigital">
    <main class="max-w-5xl mx-auto p-4 sm:p-6 w-full flex-1">
        <MisaListReact client:load token={token} />
    </main>
</Layout>
