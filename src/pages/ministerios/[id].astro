---
import AppIcon from "@/components/Ui/AppIcon.astro";
import Layout from "@/layouts/Layout.astro";
import { getUserFromToken } from "@/utils/auth";
import MinistryWorkspaceReact from "@/components/MinistryWorkspaceReact.jsx";

const token = Astro.cookies.get("token")?.value;
const user = getUserFromToken(token);

if (!user) {
    return Astro.redirect(`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/perfil");
}
---

<Layout title="Espacio del Ministerio | Cancionero">
    <main class="w-full max-w-5xl mx-auto px-3 sm:px-6 py-4 sm:py-8 pb-8 md:pb-12 min-w-0">
        <div class="mb-3 sm:mb-4">
            <a
                href="/ministerios?all=true"
                class="inline-flex items-center gap-2 text-xs font-semibold text-zinc-400 hover:text-accent-main transition-colors"
            >
                <AppIcon name="arrow-left" />
                <span>Volver a mis ministerios</span>
            </a>
        </div>

        <MinistryWorkspaceReact client:load ministryId={id} currentUser={user} token={token} />
    </main>
</Layout>
